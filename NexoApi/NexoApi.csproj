<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="NewFolder\**" />
		<Content Remove="NewFolder\**" />
		<EmbeddedResource Remove="NewFolder\**" />
		<None Remove="NewFolder\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Agente bundled: copiado automáticamente durante el publish de NexoApi.
		     El Target PublicarAgente (abajo) genera el publish del agente primero. -->
		<Content Include="..\NexoSyncAgent\publish\**\*" Exclude="..\NexoSyncAgent\publish\**\*.pdb">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>Agent\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<!-- Publica el instalador y el agente automáticamente antes de publicar NexoApi.
	     Solo se ejecuta en dotnet publish, no en build normal. -->
	<Target Name="PublicarAgentes" BeforeTargets="Publish">
		<Message Text="▶ Publicando NexoInstaladorAgente..." Importance="high" />
		<Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NexoInstaladorAgente\NexoInstaladorAgente.csproj&quot; -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -p:PublishTrimmed=true -o &quot;$(MSBuildThisFileDirectory)..\NexoSyncAgent\publish&quot; --nologo -v quiet" />
		<Message Text="▶ Publicando NexoSyncAgent..." Importance="high" />
		<Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NexoSyncAgent\NexoSyncAgent.csproj&quot; -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o &quot;$(MSBuildThisFileDirectory)..\NexoSyncAgent\publish&quot; --nologo -v quiet" />
		<Message Text="✔ Agente e instalador publicados." Importance="high" />
	</Target>

	<ItemGroup>
		<!-- Acceso a Datos -->
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />

		<!-- Autenticación y JWT -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<PackageReference Include="QuestPDF" Version="2026.7.2" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />

		<!-- OpenAPI y Swagger alineados para soportar tu código actual sin cambios -->
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
	</ItemGroup>

</Project>