# ============================================================
# .NET build output
# ============================================================
bin/
obj/
obj2/
publish/
Publish/
**/publish/
**/Publish/

# ============================================================
# Secrets — NEVER commit real values
# ============================================================
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.local.json
appsettings.Local.json
# The base appsettings.json should only have placeholder values
# Real secrets go in appsettings.Development.json (ignored above)

