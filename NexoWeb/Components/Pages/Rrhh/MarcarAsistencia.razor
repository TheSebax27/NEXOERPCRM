@page "/rrhh/marcar"
@using NexoWeb.Common.Dtos
@using NexoWeb.Common.ApiClient
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject INexoApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Marcar Asistencia</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mt-sm-10">
    @if (_cargando)
    {
        <MudPaper Class="pa-4 pa-sm-8 text-center" Elevation="2">
            <MudProgressCircular Indeterminate Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-3">Verificando...</MudText>
        </MudPaper>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Icon="@Icons.Material.Filled.ErrorOutline">
            @_error
        </MudAlert>
    }
    else if (_exito)
    {
        <MudPaper Class="pa-4 pa-sm-8 text-center" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Style="font-size:5rem; color:var(--mud-palette-success)" />
            <MudText Typo="Typo.h5" Class="mt-2 mb-1">Registrado!</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@_mensajeExito</MudText>
        </MudPaper>
    }
    else if (_estado is not null)
    {
        // Determinar la acción pendiente
        // Prioridad: sin entrada → ENTRADA. Si hay entrada y sin salida y RegistraSalida → SALIDA.
        // Con entrada+salida y TieneAlmuerzo y sin entrada2 → ENTRADA (regreso).
        // Con entrada2 y sin salida2 y RegistraSalida → SALIDA (final).
        // De lo contrario: jornada completa.
        bool jornadaCompleta;
        string tipo;
        Color color;
        string icono;
        string etiqueta;

        if (!_estado.TieneEntrada)
        {
            jornadaCompleta = false;
            tipo = "ENTRADA"; color = Color.Success;
            icono = Icons.Material.Filled.Login; etiqueta = "Marcar ENTRADA";
        }
        else if (!_estado.TieneSalida && _estado.RegistraSalida)
        {
            jornadaCompleta = false;
            tipo = "SALIDA"; color = Color.Warning;
            icono = Icons.Material.Filled.Logout; etiqueta = "Marcar SALIDA (almuerzo)";
        }
        else if (_estado.TieneSalida && _estado.TieneAlmuerzo && !_estado.TieneEntrada2)
        {
            jornadaCompleta = false;
            tipo = "ENTRADA"; color = Color.Info;
            icono = Icons.Material.Filled.RestaurantMenu; etiqueta = "Marcar ENTRADA (regreso de almuerzo)";
        }
        else if (_estado.TieneEntrada2 && !_estado.TieneSalida2 && _estado.RegistraSalida)
        {
            jornadaCompleta = false;
            tipo = "SALIDA"; color = Color.Warning;
            icono = Icons.Material.Filled.Logout; etiqueta = "Marcar SALIDA (salida final)";
        }
        else
        {
            jornadaCompleta = true;
            tipo = ""; color = Color.Default; icono = ""; etiqueta = "";
        }

        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h6" Align="Align.Center">@_estado.Empleado</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mb-4 d-block">
                @NexoWeb.Common.ColombiaClock.Now.ToString("dddd dd/MM/yyyy", new System.Globalization.CultureInfo("es-CO"))
            </MudText>

            @if (_estado.TieneEntrada)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2" Dense="true">
                    Entrada: @_estado.HoraEntrada?.ToString("HH:mm")
                    <MudChip T="string" Size="Size.Small" Class="ml-2"
                             Color="@(_estado.MetodoEntrada == "QR" ? Color.Success : Color.Warning)">
                        @_estado.MetodoEntrada
                    </MudChip>
                </MudAlert>
            }
            @if (_estado.TieneSalida)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                    Salida almuerzo: @_estado.HoraSalida?.ToString("HH:mm")
                    <MudChip T="string" Size="Size.Small" Class="ml-2"
                             Color="@(_estado.MetodoSalida == "QR" ? Color.Success : Color.Warning)">
                        @_estado.MetodoSalida
                    </MudChip>
                </MudAlert>
            }
            @if (_estado.TieneEntrada2)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2" Dense="true">
                    Regreso almuerzo: @_estado.HoraEntrada2?.ToString("HH:mm")
                    <MudChip T="string" Size="Size.Small" Class="ml-2"
                             Color="@(_estado.MetodoEntrada2 == "QR" ? Color.Success : Color.Warning)">
                        @_estado.MetodoEntrada2
                    </MudChip>
                </MudAlert>
            }

            @if (jornadaCompleta)
            {
                @if (_estado.TieneSalida2)
                {
                    <MudAlert Severity="Severity.Success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" />
                        Salida final: @_estado.HoraSalida2?.ToString("HH:mm") · Jornada completa
                    </MudAlert>
                }
                else if (_estado.TieneSalida && !_estado.TieneAlmuerzo)
                {
                    <MudAlert Severity="Severity.Success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" />
                        Salida: @_estado.HoraSalida?.ToString("HH:mm") · Jornada completa
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" />
                        Entrada registrada · Tu horario no requiere marcar salida
                    </MudAlert>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="@color" StartIcon="@icono"
                           Size="Size.Large" FullWidth="true"
                           OnClick="@(() => MarcarAsync(tipo))" Disabled="_marcando">
                    @(_marcando ? "Registrando..." : $"{etiqueta} — {NexoWeb.Common.ColombiaClock.Now:HH:mm}")
                </MudButton>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "t")] public string? T { get; set; }

    EstadoAsistenciaHoy? _estado;
    bool _cargando = true, _marcando, _exito;
    string? _error, _mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(T))
        {
            _error = "Codigo QR invalido. Escanea el codigo de la pantalla del kiosco.";
            _cargando = false;
            return;
        }
        try
        {
            _estado = await Api.GetAsync<EstadoAsistenciaHoy>("api/rrhh/asistencia/estado-hoy");
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("vinculado") || ex.Message.Contains("empleado")
                ? ex.Message
                : "No se pudo cargar tu estado de asistencia.";
        }
        finally { _cargando = false; }
    }

    async Task MarcarAsync(string tipo)
    {
        _marcando = true;
        try
        {
            await Api.PostAsync<MarcarQrRequest, object?>(
                "api/rrhh/asistencia/marcar/qr",
                new MarcarQrRequest(T!, tipo));

            _mensajeExito = $"{tipo} registrada a las {NexoWeb.Common.ColombiaClock.Now:HH:mm}";
            _exito = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _marcando = false; }
    }
}
