    private async Task CargarContratosAsync()
    {
        try
        {
            _contratos = await ApiClient.GetAsync<List<ContratoItem>>(
                $"api/rrhh/empleados/{Empleado.EmpleadoID}/contratos") ?? new();
        }
        catch { _contratos = new(); }
    }

    private async Task CargarSaldoVacacionesAsync()
    {
        try
        {
            _saldoVacaciones = await ApiClient.GetAsync<SaldoVacacionesItem>(
                $"api/rrhh/empleados/{Empleado.EmpleadoID}/saldo-vacaciones");
        }
        catch { _saldoVacaciones = null; }
    }

    private async Task RegistrarContratoAsync()
    {
        if (_cFechaInicio is null)
        {
            Snackbar.Add("Selecciona la fecha de inicio.", Severity.Warning);
            return;
        }
        _guardandoContrato = true;
        try
        {
            var request = new CrearContratoRequest(_cTipo, _cFechaInicio.Value, _cFechaFin, _cSalarioBase, _cNotas);
            await ApiClient.PostAsync<CrearContratoRequest, object?>(
                $"api/rrhh/empleados/{Empleado.EmpleadoID}/contratos", request);
            _cFechaFin = null; _cSalarioBase = null; _cNotas = null;
            Snackbar.Add("Contrato registrado.", Severity.Success);
            await CargarContratosAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoContrato = false; }
    }

    private async Task EliminarContratoAsync(int contratoId)
    {
        try
        {
            await ApiClient.DeleteAsync($"api/rrhh/contratos/{contratoId}");
            Snackbar.Add("Contrato eliminado.", Severity.Success);
            await CargarContratosAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static Color ColorContrato(string estado) => estado switch
    {
        "ACTIVO"      => Color.Success,
        "TERMINADO"   => Color.Error,
        "NO_RENOVADO" => Color.Warning,
        _             => Color.Default
    };

    private async Task CargarHorasExtrasAsync()
    {
        _horasExtras = await ApiClient.GetAsync<List<HorasExtrasItem>>(
            $"api/rrhh/empleados/{Empleado.EmpleadoID}/horas-extras") ?? new();
        _hesResumen = await ApiClient.GetAsync<ResumenHorasExtras>(
            $"api/rrhh/empleados/{Empleado.EmpleadoID}/horas-extras/resumen");
    }

    private async Task RegistrarHorasExtrasAsync()
    {
        if (_hesFecha is null || _hesCantidad is null or <= 0 || _hesValorHora is null or <= 0)
        {
            Snackbar.Add("Completa fecha, horas y valor por hora.", Severity.Warning);
            return;
        }
        _guardandoHe = true;
        try
        {
            var request = new CrearHorasExtrasRequest(_hesFecha.Value, _hesCantidad.Value, _hesValorHora.Value, _hesConcepto);
            await ApiClient.PostAsync<CrearHorasExtrasRequest, object?>(
                $"api/rrhh/empleados/{Empleado.EmpleadoID}/horas-extras", request);
            _hesCantidad = null;
            _hesConcepto = null;
            Snackbar.Add("Horas extras registradas.", Severity.Success);
            await CargarHorasExtrasAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoHe = false; }
    }

    private async Task EliminarHorasExtrasAsync(int horasExtrasId)
    {
        try
        {
            await ApiClient.DeleteAsync($"api/rrhh/horas-extras/{horasExtrasId}");
            Snackbar.Add("Registro eliminado.", Severity.Success);
            await CargarHorasExtrasAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

