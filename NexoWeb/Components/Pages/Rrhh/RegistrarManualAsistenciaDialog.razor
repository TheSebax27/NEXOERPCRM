@using NexoWeb.Common.Dtos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-2" />
            Registro Manual de Asistencia
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <strong>Atención:</strong> Este registro quedará marcado como <strong>MANUAL</strong>
            junto con tu usuario y la hora actual. Todos los registros manuales son auditables
            y visibles para gerencia. Úsalo solo cuando sea estrictamente necesario.
        </MudAlert>

        <AppSelect TValue="int?" @bind-Value="_empleadoId" Label="Empleado" Placeholder="Selecciona el empleado" Class="mb-3"
                   Items="@(Empleados.Select(e => new AppSelectItem<int?>($"{e.Nombres} {e.Apellidos}", (int?)e.EmpleadoID)))" />

        <AppSelect TValue="string?" @bind-Value="_tipo" Label="Tipo" Placeholder="Entrada o Salida" Class="mb-3"
                   Items="@(new AppSelectItem<string?>[]{ new("Entrada","ENTRADA"), new("Salida","SALIDA") })" />

        <MudDatePicker @bind-Date="_fecha" Label="Fecha" DateFormat="dd/MM/yyyy"
                       Class="mb-3" Required />
        <MudTimePicker @bind-Time="_hora" Label="Hora" Class="mb-3" Required AmPm="false" />

        <MudTextField @bind-Value="_nota" Label="Motivo (obligatorio)"
                      Lines="2" Placeholder="Explica por qué se registra manualmente..."
                      Required Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   Disabled="@(!Valido)" OnClick="Confirmar">
            Confirmar Registro Manual
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<EmpleadoItem> Empleados { get; set; } = [];

    int? _empleadoId;
    string? _tipo;
    DateTime? _fecha = NexoWeb.Common.ColombiaClock.Today;
    TimeSpan? _hora;
    string _nota = "";

    bool Valido =>
        _empleadoId.HasValue &&
        !string.IsNullOrWhiteSpace(_tipo) &&
        _fecha.HasValue &&
        _hora.HasValue &&
        !string.IsNullOrWhiteSpace(_nota);

    void Confirmar()
    {
        if (!Valido) return;
        var horaCompleta = _fecha!.Value.Date + _hora!.Value;
        MudDialog.Close(DialogResult.Ok(
            new MarcarManualRequest(_empleadoId!.Value, _tipo!, horaCompleta, _nota)));
    }

    void Cancelar() => MudDialog.Cancel();
}
