@* Nodo recursivo del organigrama — conectores CSS puros, funciona en claro y oscuro *@

<div class="org-node-wrapper">

    <div class="org-card @(_expandido && _hijos.Count > 0 ? "org-card--open" : "")"
         @onclick="ToggleExpandido">
        <div class="org-avatar org-color-@ColorIdx">
            @(Nodo.Nombres?.Length > 0 ? Nodo.Nombres[0] : '?')@(Nodo.Apellidos?.Length > 0 ? Nodo.Apellidos[0] : ' ')
        </div>
        <div class="org-info">
            <span class="org-name">@Nodo.Nombres @Nodo.Apellidos</span>
            <span class="org-role">@(Nodo.Cargo ?? "Sin cargo")</span>
        </div>
        @if (_hijos.Count > 0)
        {
            <span class="org-pill">
                @(_expandido ? "▲" : "▼") @_hijos.Count @(_hijos.Count == 1 ? "Reporte" : "Reportes")
            </span>
        }
    </div>

    @if (_expandido && _hijos.Count > 0)
    {
        <div class="org-v-connector"></div>

        <div class="org-children-row @(_hijos.Count == 1 ? "org-solo" : "")">
            @foreach (var hijo in _hijos)
            {
                <div class="org-child">
                    <div class="org-drop"></div>
                    <OrganigramaRama Nodo="hijo" Todos="Todos" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public NexoWeb.Common.Dtos.OrganigramaNodo Nodo { get; set; } = default!;
    [Parameter] public List<NexoWeb.Common.Dtos.OrganigramaNodo> Todos { get; set; } = new();

    private List<NexoWeb.Common.Dtos.OrganigramaNodo> _hijos = new();
    private bool _expandido = true;
    private string ColorIdx => (Math.Abs((Nodo.Nombres + Nodo.Apellidos).GetHashCode()) % 8).ToString();

    protected override void OnParametersSet()
        => _hijos = Todos.Where(n => n.JefeDirectoID == Nodo.EmpleadoID).ToList();

    private void ToggleExpandido()
    { if (_hijos.Count > 0) _expandido = !_expandido; }
}
