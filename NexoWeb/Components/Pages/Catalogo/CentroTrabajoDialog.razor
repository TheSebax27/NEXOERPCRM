@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            @if (!EsEdicion)
            {
                <AppSelect TValue="int?" @bind-Value="_centroCostoId" Label="Centro de Costo" Placeholder="Seleccionar..." Class="mb-3"
                           Items="@(CentrosCosto.Select(centro => new AppSelectItem<int?>(centro.Nombre, (int?)centro.CentroCostoID)))" />
            }

            <MudTextField @bind-Value="_nombre" Label="Nombre" Required="true"
                          RequiredError="El nombre es obligatorio" Class="mb-3" />

            <MudMoneyField @bind-Value="_costoHoraManoObra" Label="Costo por Hora - Mano de Obra" Class="mb-3" />
            <MudMoneyField @bind-Value="_costoHoraCIF" Label="Costo por Hora - CIF (Costos Indirectos)" Class="mb-3" />

            @if (EsEdicion)
            {
                <MudSwitch T="bool" @bind-Value="_estado" Color="Color.Success" Label="Activo" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            @(EsEdicion ? "Guardar Cambios" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<CentroCostoItem> CentrosCosto { get; set; } = new();

    // Si se pasa un CentroTrabajo existente, el dialogo entra en modo edicion
    // (oculta Centro de Costo, que no es editable una vez creado el registro).
    [Parameter] public CentroTrabajoItem? CentroTrabajo { get; set; }

    private bool EsEdicion => CentroTrabajo is not null;

    private MudForm _form = default!;
    private int? _centroCostoId;
    private string _nombre = string.Empty;
    private decimal _costoHoraManoObra;
    private decimal _costoHoraCIF;
    private bool _estado = true;

    protected override void OnInitialized()
    {
        if (CentroTrabajo is not null)
        {
            _nombre = CentroTrabajo.Nombre;
            _costoHoraManoObra = CentroTrabajo.CostoHoraManoObra;
            _costoHoraCIF = CentroTrabajo.CostoHoraCIF;
            _estado = CentroTrabajo.Estado;
        }
        else if (CentrosCosto.Count > 0)
        {
            _centroCostoId = CentrosCosto[0].CentroCostoID;
        }
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (EsEdicion)
        {
            var request = new ActualizarCentroTrabajoRequest(_nombre, _costoHoraManoObra, _costoHoraCIF, _estado);
            MudDialog.Close(DialogResult.Ok(request));
        }
        else
        {
            if (_centroCostoId is null or 0)
                return;

            var request = new CrearCentroTrabajoRequest(_nombre, _centroCostoId.Value, _costoHoraManoObra, _costoHoraCIF);
            MudDialog.Close(DialogResult.Ok(request));
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
