@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            <MudTextField @bind-Value="_nombre" Label="Nombre" Required="true"
                          RequiredError="El nombre es obligatorio" Class="mb-3" />

            @if (!EsEdicion)
            {
                <AppSelect TValue="int?" @bind-Value="_centroCostoId" Label="Centro de Costo" Placeholder="Seleccionar..." Class="mb-3"
                           Items="@(CentrosCosto.Select(centro => new AppSelectItem<int?>(centro.Nombre, (int?)centro.CentroCostoID)))" />
            }

            <AppSelect TValue="string" @bind-Value="_tipoBodega" Label="Tipo de Bodega" Class="mb-3"
                       Items="@(new AppSelectItem<string>[]{ new("Materia Prima","MATERIA_PRIMA"), new("Producto Terminado","PRODUCTO_TERMINADO"), new("WIP (En Proceso)","WIP"), new("Transito","TRANSITO") })" />

            <MudSwitch T="bool" @bind-Value="_esVirtual" Color="Color.Info" Label="Es Virtual (no fisica)" Class="mb-2" />

            @if (EsEdicion)
            {
                <MudSwitch T="bool" @bind-Value="_estado" Color="Color.Success" Label="Activa" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            @(EsEdicion ? "Guardar Cambios" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    // Catalogo de centros de costo activos para el selector; lo carga la pagina
    // que abre este dialogo, asi evitamos que el dialogo dependa de ApiClient.
    [Parameter] public List<CentroCostoItem> CentrosCosto { get; set; } = new();

    // Si se pasa una Bodega existente, el dialogo entra en modo edicion (oculta
    // Centro de Costo, que no es editable una vez creado el registro).
    [Parameter] public BodegaItem? Bodega { get; set; }

    private bool EsEdicion => Bodega is not null;

    private MudForm _form = default!;
    private string _nombre = string.Empty;
    private int? _centroCostoId;
    private string _tipoBodega = "MATERIA_PRIMA";
    private bool _esVirtual;
    private bool _estado = true;

    protected override void OnInitialized()
    {
        if (Bodega is not null)
        {
            _nombre = Bodega.Nombre;
            _tipoBodega = Bodega.TipoBodega;
            _esVirtual = Bodega.EsVirtual;
            _estado = Bodega.Estado;
        }
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (EsEdicion)
        {
            var request = new ActualizarBodegaRequest(_nombre, _tipoBodega, _esVirtual, _estado);
            MudDialog.Close(DialogResult.Ok(request));
        }
        else
        {
            if (_centroCostoId is null or 0)
                return;

            var request = new CrearBodegaRequest(_nombre, _centroCostoId.Value, _tipoBodega, _esVirtual);
            MudDialog.Close(DialogResult.Ok(request));
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
