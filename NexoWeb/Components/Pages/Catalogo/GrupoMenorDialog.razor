@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <AppSelect TValue="string?" @bind-Value="_grupoMayor" Label="Grupo Mayor" Class="mb-3"
                       Items="@(GruposMayores.Select(gm => new AppSelectItem<string?>($"{gm.Codigo} — {gm.Nombre}", gm.Codigo)))" />
            <MudTextField @bind-Value="_codigo" Label="Codigo" Required="true"
                          RequiredError="El codigo es obligatorio" Class="mb-3"
                          MaxLength="10" HelperText="Maximo 10 caracteres" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Required="true"
                          RequiredError="El nombre es obligatorio" Class="mb-1" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">Crear</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<GrupoMayorItem> GruposMayores { get; set; } = new();

    private MudForm _form = default!;
    private string? _grupoMayor;
    private string _codigo = string.Empty;
    private string _nombre = string.Empty;

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _grupoMayor is null) return;
        MudDialog.Close(DialogResult.Ok(new CrearGrupoMenorRequest(_codigo.Trim(), _nombre.Trim(), _grupoMayor)));
    }

    private void Cancelar() => MudDialog.Cancel();
}
