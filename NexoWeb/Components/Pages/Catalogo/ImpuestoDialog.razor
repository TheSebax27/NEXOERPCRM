@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <AppSelect TValue="string" Label="Tipo de impuesto" @bind-Value="_tipo"
                           Items="@(new AppSelectItem<string>[]{ new("IVA","IVA"), new("ICO (Impuesto al Consumo)","ICO") })" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" Label="@(_tipo == "ICO" ? "ICO %" : "IVA %")"
                                 @bind-Value="_valor" Variant="Variant.Outlined"
                                 Min="0" Max="100" Required="true" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField Label="Descripcion" @bind-Value="_descripcion"
                              Variant="Variant.Outlined" Placeholder="@(_tipo == "ICO" ? "ICO 8%" : "IVA 19%")" />
            </MudItem>
            @if (_tipo == "ICO")
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        El ICO solo puede ser impuesto principal. Los artículos con ICO no admiten segundo impuesto.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IvaItem? Impuesto { get; set; }

    private string _tipo = "IVA";
    private int _valor = 0;
    private string? _descripcion;

    public record Result(int Valor, string? Descripcion, string TipoImpuesto);

    protected override void OnParametersSet()
    {
        if (Impuesto is not null)
        {
            _tipo = Impuesto.TipoImpuesto ?? "IVA";
            _valor = Impuesto.Iva;
            _descripcion = Impuesto.Descripcion;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        if (_valor < 0 || _valor > 100)
        {
            Snackbar.Add("El porcentaje debe estar entre 0 y 100.", Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(new Result(_valor, _descripcion, _tipo)));
    }
}
