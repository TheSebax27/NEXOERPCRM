@* ── Dimensiones físicas (Sistema de Medidas) ───────────────────────────── *@
@if (ConfiguracionEmpresa.SistemaMedidas)
{
    <div class="nexo-section mt-4" style="margin-bottom:5rem">
        <div class="nexo-section-header">
            <MudIcon Icon="@Icons.Material.Outlined.Straighten" Size="Size.Small" />
            <span>Dimensiones físicas</span>
        </div>
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?" @bind-Value="_medLargo" Label="Largo" Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="@_medUnidad" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?" @bind-Value="_medAncho" Label="Ancho" Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="@_medUnidad" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?" @bind-Value="_medEspesor" Label="Espesor / Altura" Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="@_medUnidad" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?" @bind-Value="_medDiametro" Label="Diámetro (cilindros)" Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="@_medUnidad" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_medUnidad" Label="Unidad" Variant="Variant.Outlined">
                        <MudSelectItem Value=@("cm")>Centímetros (cm)</MudSelectItem>
                        <MudSelectItem Value=@("mm")>Milímetros (mm)</MudSelectItem>
                        <MudSelectItem Value=@("in")>Pulgadas (in)</MudSelectItem>
                        <MudSelectItem Value=@("m")>Metros (m)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="9">
                    <MudTextField @bind-Value="_medNotas" Label="Notas de dimensiones" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            @* Calculadora *@
            @{
                var vol  = CalcVolumen();
                var area = CalcArea();
                var pt   = CalcPiesTabla();
                var peso = CalcPesoEstimado();
            }
            @if (vol > 0 || area > 0)
            {
                <MudDivider Class="my-3" />
                <div style="font-size:0.78rem; font-weight:600; color:var(--n-text-2); margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Outlined.Calculate" Size="Size.Small" /> Calculadora de materiales
                </div>
                <MudGrid>
                    @if (area > 0)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div class="nexo-calc-chip">
                                <span class="nexo-calc-chip__label">Área</span>
                                <span class="nexo-calc-chip__value">@area.ToString("N2") @(_medUnidad)²</span>
                            </div>
                        </MudItem>
                    }
                    @if (vol > 0)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div class="nexo-calc-chip">
                                <span class="nexo-calc-chip__label">Volumen</span>
                                <span class="nexo-calc-chip__value">@vol.ToString("N2") @(_medUnidad)³</span>
                            </div>
                        </MudItem>
                    }
                    @if (pt > 0)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div class="nexo-calc-chip">
                                <span class="nexo-calc-chip__label">Pies tabla</span>
                                <span class="nexo-calc-chip__value">@pt.ToString("N3") pt</span>
                            </div>
                        </MudItem>
                    }
                    @if (peso > 0)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div class="nexo-calc-chip nexo-calc-chip--muted">
                                <span class="nexo-calc-chip__label">Peso est. (madera seca ~550 kg/m³)</span>
                                <span class="nexo-calc-chip__value">@peso.ToString("N2") kg</span>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            }

            <div class="d-flex justify-end mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Outlined.Straighten"
                           OnClick="GuardarMedidasAsync"
                           Disabled="_guardandoMedidas">
                    @if (_guardandoMedidas) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Guardar dimensiones
                </MudButton>
            </div>
        </MudPaper>
    </div>
}
@* ── Barra de acciones fija ───────────────────────────────────────────── *@
