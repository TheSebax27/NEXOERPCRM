    private async Task AbrirCrearPresentacionAsync()
    {
        var dialogo = await DialogService.ShowAsync<PresentacionDialog>("Nueva Presentación",
            new DialogParameters<PresentacionDialog>(),
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialogo.Result;
        if (result is null || result.Canceled || result.Data is not PresentacionDialog.Result data) return;
        var nueva = new PresentacionItem(data.Codigo, data.Nombre, data.Fracciones, data.Tipo);
