        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
                   StartIcon="@Icons.Material.Filled.Check" Disabled="_guardando || _cargando">
            @if (_guardando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Guardar cambios
        </MudButton>
    </div>
</div>

@code {
    [Parameter] public int ArticuloId { get; set; }

    private ArticuloItem? _articulo;
    private List<MarcaItem>        _marcas          = new();
    private List<GrupoMayorItem>   _gruposMayores   = new();
    private List<GrupoMenorItem>   _gruposMenores   = new();
    private List<PresentacionItem> _presentaciones  = new();
    private List<IvaItem>          _ivas            = new();
    private List<TipoArticuloItem> _tiposArticulo   = new();
    private int? _tipoArticuloId;

    private bool    _cargando  = true;
    private bool    _guardando = false;
    private string? _errorCarga;
    private MudForm _form = default!;
    private readonly long _cacheBust = DateTime.UtcNow.Ticks;

    // ── Computed ──────────────────────────────────────────────────────────
    private bool EsServicio    => (_tiposArticulo.FirstOrDefault(t => t.TipoArticuloID == _tipoArticuloId)?.Nombre
                                    ?? _articulo?.TipoArticulo) == "Servicio";
    private bool EsFraccionado => _fracciones is > 0;
    private bool EsDePeso      => _presentacionItem?.EsDePeso == true;

    private IEnumerable<GrupoMenorItem> GruposMenoresFiltrados =>
        string.IsNullOrEmpty(_grupoMayorCodigo)
            ? Enumerable.Empty<GrupoMenorItem>()
            : _gruposMenores.Where(g => g.GrupoMayor == _grupoMayorCodigo);

    private IEnumerable<IvaItem> IvasPrimarios => _ivas.Where(i =>
        i.TipoImpuesto != "ICO" &&
        !ImpuestosConsumo.Any(ic => (i.Descripcion ?? "").StartsWith(ic.Codigo)));
    private bool     IvaEsExcluidoOExento => _ivaId.HasValue && _ivaValor == 0;
    private bool     EsIcoSeleccionado    => _ivaId.HasValue && _ivas.FirstOrDefault(i => i.IvaID == _ivaId)?.TipoImpuesto == "ICO";
    private decimal  TotalImpuestoPct     => (_ivaValor ?? 0) + (_impuestoConsumoCode is not null ? (_impuestoPorcentaje ?? 0) : 0);
    private decimal? CostoConImpuesto     => _costo is > 0 ? _costo.Value * (1 + TotalImpuestoPct / 100) : _costo;

    private static readonly (string Codigo, string Nombre)[] ImpuestosConsumo =
    {
        ("IBUA", "IBUA Bebidas"),
        ("ICL",  "ICL Licores"),
        ("ICUI", "ICUI Saludable"),
        ("INPP", "INPP Plásticos"),
    };

    // ── Estado del formulario ─────────────────────────────────────────────
    private string   _nombre      = string.Empty;
    private string?  _descripcion;
    private bool     _estado      = true;
    private decimal  _stockMinimo;
    private decimal  _puntoReorden;
    private int?     _diasVidaUtil;
    // Presentación
    private string?          _presentacionCodigo;
    private PresentacionItem? _presentacionItem;
    private decimal?          _fracciones;
    private string            _fracciona = "SI";
    private decimal?          _precioVentaUnidad;
    private decimal           _margenUnidad;
    private decimal?          _peso;
    // Precios
    private decimal? _costo;
    private decimal? _ppPublico;
    private decimal? _pBodega;
    private decimal? _pCredito;
    private decimal? _uPublico;
    private decimal? _uBodega;
    private decimal? _uCredito;
    private decimal  _porcPublico;
    private decimal  _porcBodega;
    private decimal  _porcCredito;
    // Clasificación
    private string? _marcaCodigo;
    private string? _grupoMayorCodigo;
    private string? _grupoMenorCodigo;
    // IVA
    private int?     _ivaId;
    private string?  _ivaSiNo;
    private short?   _ivaValor;
    private string?  _ivaDescripcion;
    private string?  _impuestoConsumoCode;
    private decimal? _impuestoPorcentaje;
    private short?   _iva2;
    private string?  _ivaDescripcion2;
    // Imagen
    private string? _imagenBase64;
    private string? _imagenContentType;
    private string? _imagenPreviewUrl;
    private string? _imagenError;
    // Dimensiones físicas (módulo Sistema de Medidas)
    private decimal? _medLargo;
    private decimal? _medAncho;
    private decimal? _medEspesor;
    private decimal? _medDiametro;
    private string   _medUnidad  = "cm";
    private string?  _medNotas;
    private bool     _guardandoMedidas;

    // ── Carga inicial ─────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tArticulo  = ApiClient.GetAsync<ArticuloItem>($"api/catalogo/articulos/{ArticuloId}");
            var tMarcas    = ApiClient.GetAsync<List<MarcaItem>>("api/catalogo/marcas");
            var tMayores   = ApiClient.GetAsync<List<GrupoMayorItem>>("api/catalogo/grupos-mayores");
            var tMenores   = ApiClient.GetAsync<List<GrupoMenorItem>>("api/catalogo/grupos-menores");
            var tPres      = ApiClient.GetAsync<List<PresentacionItem>>("api/catalogo/presentaciones");
            var tIvas      = ApiClient.GetAsync<List<IvaItem>>("api/catalogo/ivas");
            var tTipos     = ApiClient.GetAsync<List<TipoArticuloItem>>("api/catalogo/articulos/tipos");
            await Task.WhenAll(tArticulo, tMarcas, tMayores, tMenores, tPres, tIvas, tTipos);

            _marcas          = tMarcas.Result  ?? new();
            _gruposMayores   = tMayores.Result ?? new();
            _gruposMenores   = tMenores.Result ?? new();
            _presentaciones  = tPres.Result    ?? new();
            _ivas            = tIvas.Result    ?? new();
            _tiposArticulo   = tTipos.Result   ?? new();
            _articulo       = tArticulo.Result;

            if (_articulo is null)
            {
                _errorCarga = $"No se encontró el artículo con ID {ArticuloId}.";
                return;
            }

            PopularCampos(_articulo);
            await CargarEstadoAdicionalesAsync();
            await ConfiguracionEmpresa.CargarAsync();
            if (ConfiguracionEmpresa.SistemaMedidas)
                await CargarMedidasAsync();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void PopularCampos(ArticuloItem a)
    {
        _nombre             = a.Nombre;
        _descripcion        = a.Descripcion;
        _estado             = a.Estado;
        _stockMinimo        = a.StockMinimo;
        _puntoReorden       = a.PuntoReorden;
        _diasVidaUtil       = a.DiasVidaUtil;
        _fracciones         = a.Fracciones;
        _fracciona          = a.Fracciona ?? "SI";
        _precioVentaUnidad  = a.PrecioVentaUnidad;
        _peso               = a.Peso;
        _costo              = a.Costo;
        _ppPublico          = a.PPublico;
        _pBodega            = a.PBodega;
        _pCredito           = a.PCredito;
        _uPublico           = a.UPublico;
        _uBodega            = a.UBodega;
        _uCredito           = a.UCredito;
        _marcaCodigo        = a.MarcaCodigo;
        _grupoMayorCodigo   = a.GrupoMayorCodigo;
        _grupoMenorCodigo   = a.GrupoMenorCodigo;
        _tipoArticuloId     = a.TipoArticuloID == 0 ? (int?)null : a.TipoArticuloID;
        _presentacionCodigo = a.PresentacionCodigo;
        _presentacionItem   = _presentaciones.FirstOrDefault(p => p.Codigo == _presentacionCodigo);
        _ivaSiNo            = a.IvaSiNo;
        _ivaValor           = a.IvaValor;
        _ivaDescripcion     = a.IvaDescripcion;
        _iva2               = a.Iva2;
        _ivaDescripcion2    = a.IvaDescripcion2;

        if (_ivaValor.HasValue)
            _ivaId = (_ivas.FirstOrDefault(i => i.Iva == _ivaValor && i.Descripcion == _ivaDescripcion)
                   ?? _ivas.FirstOrDefault(i => i.Iva == _ivaValor && i.TipoImpuesto != "ICO"))?.IvaID;

        if (_iva2.HasValue && _ivaDescripcion2 is not null)
        {
            var match = ImpuestosConsumo.FirstOrDefault(ic =>
                ic.Nombre == _ivaDescripcion2 || _ivaDescripcion2.StartsWith(ic.Codigo));
            if (match.Codigo is not null)
            {
                _impuestoConsumoCode = match.Codigo;
                _impuestoPorcentaje  = _iva2;
            }
        }

        _porcPublico = CalcPorc(_ppPublico);
        _porcBodega  = CalcPorc(_pBodega);
        _porcCredito = CalcPorc(_pCredito);
    }

    // ── Dimensiones físicas ───────────────────────────────────────────────
    private async Task CargarMedidasAsync()
    {
        try
        {
            var medida = await ApiClient.GetAsync<MedidaArticuloResponse>($"api/produccion/medidas/{ArticuloId}");
            if (medida is not null)
            {
                _medLargo    = medida.Largo;
                _medAncho    = medida.Ancho;
                _medEspesor  = medida.Espesor;
                _medDiametro = medida.Diametro;
                _medUnidad   = medida.UnidadMedida;
                _medNotas    = medida.Notas;
            }
        }
        catch { /* sin medidas previas */ }
    }

    private async Task GuardarMedidasAsync()
    {
        _guardandoMedidas = true;
        try
        {
            await ApiClient.PutAsync(
                $"api/produccion/medidas/{ArticuloId}",
                new ActualizarMedidaRequest(_medLargo, _medAncho, _medEspesor, _medDiametro, _medUnidad, _medNotas));
            Snackbar.Add("Dimensiones guardadas.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoMedidas = false; }
    }

    // ── Calculadora de materiales ─────────────────────────────────────────
    private decimal CalcVolumen()
    {
        if (_medLargo > 0 && _medAncho > 0 && _medEspesor > 0)
            return (_medLargo!.Value * _medAncho!.Value * _medEspesor!.Value);
        if (_medDiametro > 0 && _medEspesor > 0)
        {
            var r = _medDiametro!.Value / 2;
            return (decimal)(Math.PI * (double)(r * r) * (double)_medEspesor!.Value);
        }
        return 0;
    }

    private decimal CalcArea()
    {
        if (_medLargo > 0 && _medAncho > 0)
            return _medLargo!.Value * _medAncho!.Value;
        if (_medDiametro > 0)
        {
            var r = _medDiametro!.Value / 2;
            return (decimal)(Math.PI * (double)(r * r));
        }
        return 0;
    }

    // Pies tabla: 1 pie tabla = 1ft × 1ft × 1in = 144 in³. Factor cm→pt = /100/100/100 * 423776
    private decimal CalcPiesTabla()
    {
        if (!(_medLargo > 0) || !(_medAncho > 0) || !(_medEspesor > 0)) return 0;
        if (_medUnidad == "cm")
            return (_medLargo!.Value / 100) * (_medAncho!.Value / 100) * (_medEspesor!.Value / 100) * 423.776m;
        if (_medUnidad == "mm")
            return (_medLargo!.Value / 1000) * (_medAncho!.Value / 1000) * (_medEspesor!.Value / 1000) * 423.776m;
        if (_medUnidad == "in")
            return _medLargo!.Value * _medAncho!.Value * _medEspesor!.Value / 144m;
        if (_medUnidad == "m")
            return _medLargo!.Value * _medAncho!.Value * _medEspesor!.Value * 423.776m;
        return 0;
    }

    // Peso estimado: densidad promedio madera seca 550 kg/m³ (pino). Volumen en cm³ → m³
    private decimal CalcPesoEstimado()
    {
        var vol = CalcVolumen();
        if (vol <= 0) return 0;
        decimal volM3 = _medUnidad == "cm"  ? vol / 1_000_000m
                      : _medUnidad == "mm"  ? vol / 1_000_000_000m
                      : _medUnidad == "in"  ? vol * 0.000016387m
                      : vol; // m ya en m³
        return Math.Round(volM3 * 550, 2);
    }

    // ── Presentación ─────────────────────────────────────────────────────
    private void OnPresentacionChanged(string? codigo)
    {
        _presentacionCodigo = codigo;
        _presentacionItem   = _presentaciones.FirstOrDefault(p => p.Codigo == codigo);
