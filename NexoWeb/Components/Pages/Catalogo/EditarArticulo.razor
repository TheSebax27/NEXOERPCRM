@page "/catalogo/articulos/{ArticuloId:int}/editar"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NexoWeb.Common.Auth.ConfiguracionEmpresaState ConfiguracionEmpresa
@using NexoWeb.Common.Dtos

<PageTitle>Editar Artículo — NEXO</PageTitle>

@* ── Encabezado ───────────────────────────────────────────────────────── *@
<div class="nexo-page-header">
    <nav class="nexo-page-header__breadcrumb">
        <a class="nexo-page-header__crumb-link" href="/catalogo/articulos">Artículos</a>
        <span class="nexo-page-header__crumb-sep">›</span>
        <span class="nexo-page-header__crumb-cur">@(_articulo?.Nombre ?? "Cargando…")</span>
    </nav>
    <div class="nexo-page-header__body">
        <div>
            <h1 class="nexo-page-header__title">Editar artículo</h1>
            @if (_articulo is not null)
            {
                <p class="nexo-page-header__sub">
                    <span class="na-sku-badge">@_articulo.Referencia</span>
                    &nbsp;· @(_tiposArticulo.FirstOrDefault(t => t.TipoArticuloID == _tipoArticuloId)?.Nombre ?? _articulo.TipoArticulo)
                    @if (!_estado)
                    {
                        <span class="na-inactivo-badge ml-2">Inactivo</span>
                    }
                </p>
            }
        </div>
        @if (_articulo is not null)
        {
            <MudSwitch T="bool" @bind-Value="_estado" Color="Color.Success"
                       Label="@(_estado ? "Activo" : "Inactivo")"
                       Style="margin:0;" />
        }
    </div>
</div>

@if (_cargando)
{
    <div class="d-flex justify-center align-center" style="min-height:300px;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudo cargar el artículo: @_errorCarga</MudAlert>
}
else
{
    <MudForm @ref="_form" Model="@this">
        <div class="nexo-form-layout">

            @* ── Fila 1: Información básica + Clasificación ──────────────── *@
            <div class="nexo-form-row-2">

                @* Información básica *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(124,92,255,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Style="color:var(--n-purple); font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">Información básica</div>
                            <div class="nexo-section__sub">SKU: @_articulo!.Referencia (no editable)</div>
                        </div>
                    </div>
                    <div class="nexo-section__body">
                        <MudTextField @bind-Value="_nombre" Label="Nombre del artículo" Required="true"
                                      RequiredError="El nombre es obligatorio"
                                      Variant="Variant.Outlined" Class="mb-4" />
                        <MudTextField @bind-Value="_descripcion" Label="Descripción" Lines="3"
                                      Placeholder="Describe las características, usos o detalles importantes del artículo..."
                                      Variant="Variant.Outlined" Class="mb-1" />
                        <p class="na-field-hint">Información adicional que ayudará a identificar el artículo.</p>
                    </div>
                </div>

                @* Clasificación *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(16,185,129,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Sell" Style="color:#10B981; font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">Clasificación</div>
                        </div>
                    </div>
                    <div class="nexo-section__body">
                        <AppSelect TValue="int?" @bind-Value="_tipoArticuloId" Label="Tipo de artículo" Class="mb-4"
                                   Items="@(_tiposArticulo.Select(t => new AppSelectItem<int?>(t.Nombre, (int?)t.TipoArticuloID)))" />
                        <AppSelect TValue="string?" @bind-Value="_marcaCodigo" Label="Marca" Placeholder="Sin marca" Class="mb-4"
                                   Items="@(_marcas.Select(m => new AppSelectItem<string?>($"{m.Codigo} — {m.Nombre}", m.Codigo)))" />
                        <div class="na-field-row na-field-row--2">
                            <AppSelect TValue="string?" Value="_grupoMayorCodigo" ValueChanged="OnGrupoMayorChanged"
                                       Label="Grupo mayor" Placeholder="Sin grupo mayor"
                                       Items="@(_gruposMayores.Select(gm => new AppSelectItem<string?>($"{gm.Codigo} — {gm.Nombre}", gm.Codigo)))" />
                            <AppSelect TValue="string?" Value="_grupoMenorCodigo" ValueChanged="OnGrupoMenorChanged"
                                       Label="Grupo menor"
                                       Placeholder="@(string.IsNullOrEmpty(_grupoMayorCodigo) ? "Selecciona grupo mayor primero" : "Sin grupo menor")"
                                       Disabled="@(string.IsNullOrEmpty(_grupoMayorCodigo))"
                                       Items="@(GruposMenoresFiltrados.Select(gm => new AppSelectItem<string?>($"{gm.Codigo} — {gm.Nombre}", gm.Codigo)))" />
                        </div>
                    </div>
                </div>
            </div>

            @* ── Presentación + IVA ───────────────────────────────────────── *@
            <div class="nexo-form-row-2">

                @* Presentación *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(245,158,11,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="color:#F59E0B; font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">Presentación</div>
                            <div class="nexo-section__sub">Define cómo se empaca o presenta el artículo</div>
                        </div>
                    </div>
                    <div class="nexo-section__body">
                        <div class="d-flex align-center mb-4" style="gap:0.5rem;">
                            <AppSelect TValue="string?" Value="_presentacionCodigo" ValueChanged="OnPresentacionChanged"
                                       Label="Presentación" Placeholder="Sin presentación"
                                       Style="flex:1;"
                                       Items="@(_presentaciones.Select(p => new AppSelectItem<string?>($"{p.Codigo} — {p.Presentacion}{(p.Fracciones is > 0 ? $" ({p.Fracciones!.Value.ToString("N0")} und)" : "")}", p.Codigo)))" />
                            <MudTooltip Text="Nueva presentación">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary"
                                               OnClick="AbrirCrearPresentacionAsync" />
                            </MudTooltip>
                        </div>
                        @if (EsFraccionado)
                        {
                            <div class="na-embalaje-badge mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:var(--n-success); font-size:1rem;" />
                                <span>Presentación de <strong>@_fracciones!.Value.ToString("N0")</strong> unidades por paquete</span>
                            </div>
                            <div class="mb-3">
                                <p class="na-label mb-2">¿Cómo se vende?</p>
                                <MudRadioGroup T="string" @bind-Value="_fracciona">
                                    <MudRadio T="string" Value="@("SI")" Color="Color.Primary">En caja y en unidades sueltas</MudRadio>
                                    <MudRadio T="string" Value="@("NO")" Color="Color.Primary">Solo en caja/paquete completo</MudRadio>
                                </MudRadioGroup>
                            </div>
                            @if (_ppPublico is > 0)
                            {
                                <div class="na-field-row na-field-row--2">
                                    <MudNumericField T="decimal" @bind-Value="_margenUnidad"
                                                     @bind-Value:after="RecalcPrecioUnidad"
                                                     Label="% ganancia por unidad suelta" Min="0m" Format="N1"
                                                     Variant="Variant.Outlined"
                                                     Adornment="Adornment.End" AdornmentText="%" />
                                    <MudNumericField T="decimal?" @bind-Value="_precioVentaUnidad"
                                                     Label="Precio unidad suelta" Format="N0" Min="0m"
                                                     Variant="Variant.Outlined"
                                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                                </div>
                            }
                        }
                        @if (EsDePeso)
                        {
                            <MudNumericField T="decimal?" @bind-Value="_peso" Label="Peso (kg)" Format="N3" Min="0m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.MonitorWeight" />
                        }
                        @if (!EsFraccionado && !EsDePeso)
                        {
                            <p class="na-field-hint" style="margin-top:0;">Selecciona una presentación para ver las unidades por paquete.</p>
                        }
                    </div>
                </div>

                @* IVA *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(14,165,233,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" Style="color:#0EA5E9; font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">IVA e Impuestos</div>
                            <div class="nexo-section__sub">Configuración fiscal del artículo</div>
                        </div>
                    </div>
                    <div class="nexo-section__body">
                        <AppSelect TValue="int?" Value="_ivaId" ValueChanged="OnIvaChanged"
                                   Label="Impuesto 1 — IVA" Placeholder="Sin IVA" Class="mb-4"
                                   Items="@(IvasPrimarios.Select(iva => new AppSelectItem<int?>($"{iva.Descripcion} ({iva.Iva}%)", (int?)iva.IvaID)))" />
                        @if (_ivaId.HasValue && !IvaEsExcluidoOExento && !EsIcoSeleccionado)
                        {
                            <AppSelect TValue="string?" Value="_impuestoConsumoCode" ValueChanged="OnImpuestoConsumoChanged"
                                       Label="Impuesto 2 — Consumo (opcional)" Placeholder="Ninguno" Class="mb-3"
                                       Items="@(ImpuestosConsumo.Select(ic => new AppSelectItem<string?>($"{ic.Nombre} (0%)", ic.Codigo)))" />
                            @if (_impuestoConsumoCode is not null)
                            {
                                <MudNumericField T="decimal?" @bind-Value="_impuestoPorcentaje"
                                                 @bind-Value:after="OnImpuestoPorcentajeChanged"
                                                 Label="Porcentaje del impuesto" Min="0m" Max="100m" Format="N2"
                                                 Variant="Variant.Outlined" Class="mb-2"
                                                 Adornment="Adornment.End" AdornmentText="%" />
                                <p class="na-field-hint">Ingresa el porcentaje aplicable según la normativa vigente.</p>
                            }
                        }
                        @if (!_ivaId.HasValue)
                        {
                            <div class="na-iva-empty">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:1.1rem; color:var(--n-text-3);" />
                                <span>Sin IVA configurado. La mayoría de artículos no gravados pueden omitir este campo.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Precios y Costos ─────────────────────────────────────────── *@
            <div class="nexo-section">
                <div class="nexo-section__header">
                    <div class="nexo-section__icon" style="background: rgba(239,68,68,0.10);">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Style="color:#EF4444; font-size:1.25rem;" />
                    </div>
                    <div>
                        <div class="nexo-section__title">Precios y Costos</div>
                        <div class="nexo-section__sub">Define el costo y los precios de venta por canal</div>
                    </div>
                </div>
                <div class="nexo-section__body">
                    @if (_articulo!.CostoPromedio > 0)
                    {
                        <div class="na-costo-promedio-badge mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="font-size:1rem;" />
                            <span>Costo promedio ponderado: <strong>@_articulo.CostoPromedio.ToString("N0")</strong></span>
                        </div>
                    }
                    <div class="na-precios-grid">
                        @* Costo *@
                        <div class="na-precio-col na-precio-col--costo">
                            <div class="na-precio-label">Costo</div>
                            <MudNumericField T="decimal?" @bind-Value="_costo" @bind-Value:after="OnCostoChanged"
                                             Label="Costo de adquisición" Format="N0" Min="0m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ShoppingCart" />
                            <p class="na-field-hint">Costo de compra o producción por unidad (sin impuestos).</p>
                            @if (TotalImpuestoPct > 0 && _costo is > 0)
                            {
                                <div class="na-costo-impuesto-badge mt-2">
                                    <span>Con impuestos (@TotalImpuestoPct.ToString("N1")%): <strong>@CostoConImpuesto!.Value.ToString("N0")</strong></span>
                                </div>
                            }
                        </div>
                        @* Precio Público *@
                        <div class="na-precio-col">
                            <div class="na-precio-label">Precio Público</div>
                            <MudNumericField T="decimal?" Value="_ppPublico" ValueChanged="OnPPPublicoChanged"
                                             Label="Precio de venta sugerido" Format="N0" Min="0m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Class="mb-2" />
                            <MudNumericField T="decimal" Value="_porcPublico" ValueChanged="OnPorcPublicoChanged"
                                             Label="% Utilidad" Format="N1" Min="0m" Max="9999m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End" AdornmentText="%" />
                            @if (_uPublico.HasValue)
                            {
                                <div class="na-util-badge mt-1">
                                    <span>Utilidad: <strong>@_uPublico.Value.ToString("C0")</strong></span>
                                </div>
                            }
                        </div>
                        @* Precio Bodega *@
                        <div class="na-precio-col">
                            <div class="na-precio-label">Precio Bodega</div>
                            <MudNumericField T="decimal?" Value="_pBodega" ValueChanged="OnPBodegaChanged"
                                             Label="Precio por mayor" Format="N0" Min="0m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocalShipping" Class="mb-2" />
                            <MudNumericField T="decimal" Value="_porcBodega" ValueChanged="OnPorcBodegaChanged"
                                             Label="% Utilidad" Format="N1" Min="0m" Max="9999m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End" AdornmentText="%" />
                            @if (_uBodega.HasValue)
                            {
                                <div class="na-util-badge mt-1">
                                    <span>Utilidad: <strong>@_uBodega.Value.ToString("C0")</strong></span>
                                </div>
                            }
                        </div>
                        @* Precio Crédito *@
                        <div class="na-precio-col">
                            <div class="na-precio-label">Precio Crédito</div>
                            <MudNumericField T="decimal?" Value="_pCredito" ValueChanged="OnPCreditoChanged"
                                             Label="Precio para crédito" Format="N0" Min="0m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CreditCard" Class="mb-2" />
                            <MudNumericField T="decimal" Value="_porcCredito" ValueChanged="OnPorcCreditoChanged"
                                             Label="% Utilidad" Format="N1" Min="0m" Max="9999m"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End" AdornmentText="%" />
                            @if (_uCredito.HasValue)
                            {
                                <div class="na-util-badge mt-1">
                                    <span>Utilidad: <strong>@_uCredito.Value.ToString("C0")</strong></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── Stock + Imagen ───────────────────────────────────────────── *@
            <div class="nexo-form-row-2">

                @* Control de Inventario *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(124,92,255,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Warehouse" Style="color:var(--n-purple); font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">Control de Inventario</div>
                            <div class="nexo-section__sub">Umbrales y parámetros de stock</div>
                        </div>
                    </div>
                    <div class="nexo-section__body">
                        <div class="na-field-row na-field-row--2">
                            <MudNumericField @bind-Value="_stockMinimo" Label="Stock mínimo" Min="0m"
                                             Format="N2" Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Warning" />
                            <MudNumericField @bind-Value="_puntoReorden" Label="Punto de reorden" Min="0m"
                                             Format="N2" Variant="Variant.Outlined"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.TrendingDown" />
                        </div>
                        @if (!EsServicio)
                        {
                            <MudNumericField @bind-Value="_diasVidaUtil" Label="Vida útil (días hasta caducidad)"
                                             Min="0" Variant="Variant.Outlined" Class="mb-1"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.EventBusy" />
                            @if (_diasVidaUtil is > 0)
                            {
                                <p class="na-field-hint">
                                    Caducaría aproximadamente el @NexoWeb.Common.ColombiaClock.Today.AddDays(_diasVidaUtil.Value).ToString("dd/MM/yyyy").
                                </p>
                            }
                        }
                        @if (_articulo!.Existencias > 0)
                        {
                            <div class="na-stock-badge mt-3">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory" Style="font-size:1rem;" />
                                <span>Stock actual: <strong>@_articulo.Existencias.ToString("N2")</strong></span>
                            </div>
                        }
                    </div>
                </div>

                @* Imagen *@
                <div class="nexo-section">
                    <div class="nexo-section__header">
                        <div class="nexo-section__icon" style="background: rgba(124,92,255,0.10);">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Style="color:var(--n-purple); font-size:1.25rem;" />
                        </div>
                        <div>
                            <div class="nexo-section__title">Imagen del artículo</div>
                            <div class="nexo-section__sub">Agrega o actualiza la imagen</div>
                        </div>
                    </div>
                    <div class="nexo-section__body na-imagen-body">
                        @if (_imagenPreviewUrl is not null)
                        {
                            <div class="na-imagen-preview">
                                <img src="@_imagenPreviewUrl" alt="Preview" class="na-imagen-preview__img" />
                                <button class="na-imagen-preview__clear" @onclick="LimpiarImagen">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:1rem;" />
                                </button>
                            </div>
                        }
                        else if (_articulo!.TieneImagen)
                        {
                            <div class="na-imagen-preview">
                                <img src="@($"api/catalogo/articulos/{ArticuloId}/imagen?v={_cacheBust}")"
                                     alt="Imagen actual" class="na-imagen-preview__img" />
                            </div>
                        }
                        else
                        {
                            <label for="nexo-editar-articulo-imagen" class="na-upload-zone">
                                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload"
                                         Style="font-size:2.5rem; color:var(--n-purple); opacity:.7; display:block; margin-bottom:.5rem;" />
                                <span class="na-upload-zone__title">Arrastra una imagen aquí</span>
                                <span class="na-upload-zone__sub">o haz clic para seleccionar</span>
                                <span class="na-upload-zone__hint">JPG, PNG o WebP · Máx. 1 MB</span>
                            </label>
                        }
                        <InputFile id="nexo-editar-articulo-imagen" OnChange="OnImagenSeleccionadaAsync"
                                   accept="image/png,image/jpeg,image/webp" style="display:none;" />
                        <label for="nexo-editar-articulo-imagen" class="na-btn-cambiar-imagen mt-3">
                            @(_imagenPreviewUrl is not null || _articulo!.TieneImagen ? "Cambiar imagen" : "Subir imagen")
                        </label>
                        @if (_imagenError is not null)
                        {
                            <p class="na-field-hint" style="color:var(--n-error); margin-top:.5rem;">@_imagenError</p>
                        }
                    </div>
                </div>
            </div>

        </div>
    </MudForm>
}

@* ── Historial de precios ───────────────────────────────────────────────── *@
@if (_articulo is not null)
{
    <div class="nexo-section mt-4 mb-2">
        <div class="nexo-section__header" style="cursor:pointer;" @onclick="ToggleHistorial">
            <div class="nexo-section__icon" style="background:rgba(234,88,12,0.10);">
                <MudIcon Icon="@Icons.Material.Filled.History" Style="color:#EA580C; font-size:1.25rem;" />
            </div>
            <div style="flex:1;">
                <div class="nexo-section__title">Historial de precios</div>
                <div class="nexo-section__sub">Registro de cambios de Costo, P.Público, P.Bodega y P.Crédito</div>
            </div>
            <MudIcon Icon="@(_mostrarHistorial ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Style="color:var(--n-text-3);" />
        </div>
        @if (_mostrarHistorial)
        {
            <div class="nexo-section__body">
                @if (_cargandoHistorial)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2" />
                }
                else if (_historialPrecios.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Aún no hay cambios de precio registrados para este artículo.
                    </MudText>
                }
                else
                {
                    <MudTable Items="_historialPrecios" Hover Dense Striped Breakpoint="Breakpoint.Sm"
                              Style="margin-top:.5rem;">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Usuario</MudTh>
                            <MudTh>Campo</MudTh>
                            <MudTh Style="text-align:right;">Valor anterior</MudTh>
                            <MudTh Style="text-align:right;">Valor nuevo</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fecha">@context.FechaCambio.ToLocalTime().ToString("dd/MM/yy HH:mm")</MudTd>
                            <MudTd DataLabel="Usuario">@context.NombreUsuario</MudTd>
                            <MudTd DataLabel="Campo">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@ColorCampo(context.Campo)">
                                    @LabelCampo(context.Campo)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Anterior" Style="text-align:right; font-family:monospace;">
                                @((context.ValorAnterior ?? 0).ToString("N2"))
                            </MudTd>
                            <MudTd DataLabel="Nuevo" Style="text-align:right; font-family:monospace; font-weight:600;">
                                @((context.ValorNuevo ?? 0).ToString("N2"))
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
        }
    </div>
}

@* ── Simulador de precio ─────────────────────────────────────────────────── *@
@if (_articulo is not null && (_articulo.Costo ?? 0) > 0)
{
    <div class="nexo-section mt-4 mb-2">
        <div class="nexo-section__header" style="cursor:pointer;" @onclick="ToggleSimulador">
            <div class="nexo-section__icon" style="background:rgba(16,185,129,0.10);">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" Style="color:#10B981; font-size:1.25rem;" />
            </div>
            <div style="flex:1;">
                <div class="nexo-section__title">Simulador de precio</div>
                <div class="nexo-section__sub">Ajusta el margen y ve el precio resultante — no guarda hasta que apliques</div>
            </div>
            <MudIcon Icon="@(_mostrarSimulador ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Style="color:var(--n-text-3);" />
        </div>
        @if (_mostrarSimulador)
        {
            var costoBase  = _articulo.Costo ?? 0;
            var precioCalc = _margenSim < 100 ? Math.Ceiling(costoBase / (1m - _margenSim / 100m) / 10) * 10 : 0;
            var utilidadCalc = precioCalc - costoBase;
            <div class="nexo-section__body">
                <div class="d-flex align-center flex-wrap mb-3" style="gap:1.5rem;">
                    <div>
                        <div style="font-size:0.75rem;color:var(--n-text-3)">Costo actual</div>
                        <div style="font-size:1.2rem;font-weight:700">@costoBase.ToString("C0")</div>
                    </div>
                    <div>
                        <div style="font-size:0.75rem;color:var(--n-text-3)">Precio sugerido</div>
                        <div style="font-size:1.5rem;font-weight:700;color:var(--mud-palette-primary)">@precioCalc.ToString("C0")</div>
                    </div>
                    <div>
                        <div style="font-size:0.75rem;color:var(--n-text-3)">Utilidad</div>
                        <div style="font-size:1.2rem;font-weight:700;color:var(--mud-palette-success)">@utilidadCalc.ToString("C0")</div>
                    </div>
                </div>
                <MudText Typo="Typo.caption">Margen deseado: <strong>@_margenSim.ToString("0.0")%</strong></MudText>
                <MudSlider T="decimal" @bind-Value="_margenSim" Min="0" Max="90" Step="0.5m"
                           Color="Color.Primary" Class="mb-2" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                           OnClick="@(() => { _ppPublico = precioCalc; })"
                           StartIcon="@Icons.Material.Filled.Check">
                    Aplicar como P.Público
                </MudButton>
            </div>
        }
    </div>
}

