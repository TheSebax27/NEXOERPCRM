    // ── Ficha técnica PDF ─────────────────────────────────────────────────
    private bool _descargandoFicha;
    private async Task DescargarFichaPdfAsync()
    {
        _descargandoFicha = true;
        try
        {
            var bytes = await ApiClient.GetBytesAsync($"api/catalogo/articulos/{ArticuloId}/ficha-pdf");
            var b64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("nexoDescargarArchivo",
                $"ficha_{_articulo!.Referencia}.pdf", "application/pdf", b64);
        }
        catch { Snackbar.Add("No se pudo generar la ficha.", Severity.Error); }
        finally { _descargandoFicha = false; }
    }

    // ── Variantes ─────────────────────────────────────────────────────────
    private List<VarianteItem> _variantes = new();
    private bool _mostrarVariantes;
    private bool _cargandoVariantes;
    private bool _guardandoVariante;
    private string? _nuevaVarianteLabel;
    private string? _nuevaVarianteSku;

    private async Task ToggleVariantes()
    {
        _mostrarVariantes = !_mostrarVariantes;
        if (_mostrarVariantes && _variantes.Count == 0 && !_cargandoVariantes)
        {
            _cargandoVariantes = true;
            try { _variantes = await ApiClient.GetAsync<List<VarianteItem>>($"api/catalogo/articulos/{ArticuloId}/variantes") ?? new(); }
            catch { }
            finally { _cargandoVariantes = false; }
        }
    }

    private async Task CrearVarianteAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevaVarianteLabel)) return;
        _guardandoVariante = true;
        try
        {
            var req = new CrearVarianteRequest(_nuevaVarianteLabel.Trim(),
                string.IsNullOrWhiteSpace(_nuevaVarianteSku) ? null : _nuevaVarianteSku.Trim(),
                null);
            await ApiClient.PostAsync<CrearVarianteRequest, object?>($"api/catalogo/articulos/{ArticuloId}/variantes", req);
            Snackbar.Add($"Variante '{_nuevaVarianteLabel}' creada.", Severity.Success);
            _nuevaVarianteLabel = null;
            _nuevaVarianteSku   = null;
            _variantes = await ApiClient.GetAsync<List<VarianteItem>>($"api/catalogo/articulos/{ArticuloId}/variantes") ?? new();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _guardandoVariante = false; }
    }

    // ── Adicionales ───────────────────────────────────────────────────────
    private bool _esAdicional;
    private int  _cantidadAdicionales;

    private async Task CargarEstadoAdicionalesAsync()
    {
        try
        {
            var tEsAdicional = ApiClient.GetAsync<bool>($"api/catalogo/articulos/{ArticuloId}/es-adicional");
            var tAsignados   = ApiClient.GetAsync<List<ArticuloAdicionalItem>>($"api/catalogo/articulos/{ArticuloId}/adicionales");
            await Task.WhenAll(tEsAdicional, tAsignados);
            _esAdicional         = tEsAdicional.Result;
            _cantidadAdicionales = (tAsignados.Result ?? new()).Count;
        }
        catch { }
    }

    private async Task OnEsAdicionalChangedAsync(bool valor)
    {
        _esAdicional = valor;
        try
        {
            await ApiClient.PostAsync<MarcarEsAdicionalRequest>(
                $"api/catalogo/articulos/{ArticuloId}/es-adicional",
                new MarcarEsAdicionalRequest(valor));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
            _esAdicional = !valor;
        }
    }

    private async Task AbrirAdicionalesDialogAsync()
    {
        var params_ = new DialogParameters<AdicionalesDialog>
        {
            { x => x.ArticuloID, ArticuloId }
        };
        var dialogo = await DialogService.ShowAsync<AdicionalesDialog>("Acompañamientos",
            params_,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialogo.Result;
        if (result is not null && !result.Canceled && result.Data is int count)
            _cantidadAdicionales = count;
    }
