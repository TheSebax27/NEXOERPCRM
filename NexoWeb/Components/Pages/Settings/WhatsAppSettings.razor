@code {
    private bool    _cargando = true;
    private bool    _guardando;
    private bool    _activo;
    private bool    _mostrarAuthToken;
    private string? _accountSid;
    private string? _authToken;
    private string  _fromNumber = "whatsapp:+14155238886";

    private bool     _enviandoPrueba;
    private string?  _telefonoPrueba;
    private string?  _resultadoPrueba;
    private Severity _severidadPrueba = Severity.Success;

    // ── Calculadora de costos ──────────────────────────────────────────
    private int    _clientesMes = 100;
    private string _tipoCosto   = "utilidad";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var config = await ApiClient.GetAsync<WhatsAppConfigItem>("api/whatsapp/config");
            if (config is not null)
            {
                _activo     = config.Activo;
                _accountSid = config.AccountSid;
                _authToken  = config.AuthToken;
                _fromNumber = config.FromNumber;
            }
            await CargarNumerosWaAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _cargando = false; }
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        try
        {
            var req = new WhatsAppConfigItem(_accountSid, _authToken, _fromNumber, _activo);
            await ApiClient.PutAsync<WhatsAppConfigItem, object?>("api/whatsapp/config", req);
            Snackbar.Add("Configuración guardada correctamente.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardando = false; }
    }

    private async Task EnviarPruebaAsync()
    {
        _enviandoPrueba  = true;
        _resultadoPrueba = null;
        try
        {
            await ApiClient.PostAsync<object?, object?>(
                $"api/whatsapp/test?telefono={Uri.EscapeDataString(_telefonoPrueba!)}", null);
            _resultadoPrueba = $"✅ Mensaje enviado al {_telefonoPrueba}. Revisa tu WhatsApp — puede tardar unos segundos.";
            _severidadPrueba = Severity.Success;
        }
        catch (HttpRequestException ex)
        {
            _resultadoPrueba = $"❌ {ex.Message}";
            _severidadPrueba = Severity.Error;
        }
        finally { _enviandoPrueba = false; }
    }

    // ── Números WhatsApp del negocio ──────────────────────────────────────
    private record NumeroWaItem(int NumeroWAID, string Descripcion, string Numero,
        int? EmpleadoID, string? NombreEmpleado, int? CentroCostoID, string? NombreCentroCosto, bool Activo);

    private List<NumeroWaItem>? _numerosWa;
    private NuevoNumeroForm _nuevoNumero = new();

    private class NuevoNumeroForm
    {
        public string Descripcion { get; set; } = "";
        public string Numero { get; set; } = "";
    }

    private async Task CargarNumerosWaAsync()
    {
        var items = await ApiClient.GetAsync<IEnumerable<NumeroWaItem>>("api/whatsapp/numeros");
        _numerosWa = items?.ToList() ?? [];
    }

    private async Task AgregarNumeroAsync()
    {
        var req = new { _nuevoNumero.Descripcion, _nuevoNumero.Numero, EmpleadoID = (int?)null, CentroCostoID = (int?)null };
        await ApiClient.PostAsync<object, object?>("api/whatsapp/numeros", req);
        Snackbar.Add("Número agregado", Severity.Success);
        _nuevoNumero = new();
        await CargarNumerosWaAsync();
    }

    private async Task ToggleNumeroAsync(int id)
    {
        await ApiClient.PutAsync<object?, object?>($"api/whatsapp/numeros/{id}/toggle", null);
        await CargarNumerosWaAsync();
    }

    private async Task EliminarNumeroAsync(int id)
    {
        await ApiClient.DeleteAsync($"api/whatsapp/numeros/{id}");
        await CargarNumerosWaAsync();
        Snackbar.Add("Número eliminado", Severity.Info);
    }
}
