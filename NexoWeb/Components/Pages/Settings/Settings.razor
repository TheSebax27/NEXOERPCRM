                                           StartIcon="@(_modoLotes == "FIFO" ? Icons.Material.Filled.Check : Icons.Material.Filled.Sort)"
                                           OnClick="@(() => _modoLotes = "FIFO")">
                                    Automatico (FIFO)
                                </MudButton>
                                <MudButton Variant="@(_modoLotes == "MANUAL" ? Variant.Filled : Variant.Outlined)"
                                           Color="@(_modoLotes == "MANUAL" ? Color.Primary : Color.Default)"
                                           StartIcon="@(_modoLotes == "MANUAL" ? Icons.Material.Filled.Check : Icons.Material.Filled.TouchApp)"
                                           OnClick="@(() => _modoLotes = "MANUAL")">
                                    Manual
                                </MudButton>
                            </MudButtonGroup>
                            @if (_modoLotes == "FIFO")
                            {
                                <div style="font-size:0.75rem; color:var(--n-text-3); margin-top:6px">
                                    El sistema usa siempre el primer lote ingresado (el mas antiguo) — sin intervencion del usuario.
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.75rem; color:var(--n-text-3); margin-top:6px">
                                    Al liberar una orden el operario elige que lotes consumir (util cuando hay lotes de distintas calidades).
                                </div>
                            }
                        </div>

                        <MudDivider Class="mb-4" />

                        <div class="d-flex align-center justify-space-between mb-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem">Manejar fechas de vencimiento</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3)">
                                    Activa alertas y validaciones cuando un lote esta proximo a vencer o ya vencio.
                                </div>
                            </div>
                            <MudSwitch T="bool" @bind-Value="_manejarVencimientos" Color="Color.Primary" />
                        </div>

                        @if (_manejarVencimientos)
                        {
                            <div class="mt-3" style="max-width:280px">
                                <MudNumericField T="int" @bind-Value="_diasAlertaVencimiento"
                                                 Label="Alertar con cuantos dias de anticipacion"
                                                 Min="1" Max="365" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HelperText="Se mostrara una advertencia cuando falten este numero de dias para que un lote venza." />
                            </div>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                                   OnClick="GuardarConfigInventarioAsync" Disabled="_guardandoInventario">
                            @(_guardandoInventario ? "Guardando..." : "Guardar configuracion de inventario")
                        </MudButton>
                    </MudPaper>

                    @* ── Venta desde Receta ── *@
                    <MudPaper Class="pa-5 rounded-xl" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700">Venta desde Receta</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--n-text-3)">
                                    Al descontar stock de una factura, consume los insumos de la receta en vez del stock del producto terminado.
                                </MudText>
                            </div>
                        </div>

                        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                            Todos los articulos de la factura deben tener una receta activa. Si alguno no tiene, el descuento falla.
                        </MudAlert>

                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem">Activar Venta desde Receta</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3)">
                                    Aplica a facturas de NEXO y de Visions. <strong>No usar junto con Órdenes de Producción manuales</strong> — los modos son excluyentes.
                                </div>
                            </div>
                            <MudSwitch T="bool" Value="ConfiguracionEmpresa.VentaDesdeReceta"
                                       ValueChanged="OnVentaDesdeRecetaCambiadaAsync"
                                       Color="Color.Warning" />
                        </div>
                    </MudPaper>

                    @* â"€â"€ Numeracion de Documentos â"€â"€ *@
                    <MudPaper Class="pa-5 rounded-xl" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                        <div class="d-flex align-center gap-3 mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Tag" Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700">Numeración de Documentos</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--n-text-3)">
                                    Define cómo se genera el número de documento al crear facturas y remisiones.
                                </MudText>
                            </div>
                        </div>

                        <AppSelect TValue="string" @bind-Value="_modoNroDoc" Label="Modo de numeración" Class="mb-3"
                                   Items="@(new AppSelectItem<string>[]{ new("Manual — el usuario escribe el número","Manual"), new("Secuencial — contador propio de NEXO","Secuencial"), new("Aleatorio — 10 dígitos aleatorios","Aleatorio") })" />

                        @if (_modoNroDoc == "Secuencial")
                        {
                            <MudNumericField T="long" @bind-Value="_ultimoNroDocSecuencial"
                                             Label="Último número usado (el siguiente será este + 1)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                             Min="0" />
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="GuardarConfigNroDocAsync" Disabled="_guardandoNroDoc">
                            @(_guardandoNroDoc ? "Guardando..." : "Guardar configuracion de numeracion")
                        </MudButton>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

        @* â"€â"€ Integraciones (Administracion) â"€â"€ *@
        else if (_seccion == "integraciones")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Integraciones</div>
                                <div class="nexo-chart-header__sub">Configura que sistemas externos usa esta empresa</div>
                            </div>
                        </div>

                        <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
                            <strong>¿Qué es Visions?</strong> Visions es el sistema de facturación/punto de venta externo
                            con el que NEXO puede sincronizar ventas e inventario. Si esta empresa <strong>no usa Visions</strong>,
                            desactiva esta opción para ocultar las funciones relacionadas (Mapeo de Artículos Visions,
                            configuración Visions en Centros de Costo, etc.).
                        </MudAlert>

                        <div class="d-flex align-center justify-space-between py-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem;">La empresa utiliza Visions</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3);">
                                    Activa o desactiva la integracion con Visions para toda la plataforma.
                                </div>
                            </div>
                            <MudSwitch T="bool" Value="ConfiguracionEmpresa.UsaVisions"
                                       ValueChanged="OnUsaVisionsCambiadoAsync"
                                       Color="Color.Primary" />
                        </div>

                        @if (ConfiguracionEmpresa.UsaVisions)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-2"
                                       StartIcon="@Icons.Material.Outlined.SyncAlt"
                                       OnClick="@(() => Navegacion.NavigateTo("/admin/integracion-visions"))">
                                Estado del agente e instalacion
                            </MudButton>
                        }
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

    </div>
</div>

@code {
    private string _seccion = "apariencia";

    // â"€â"€ Orden del menú lateral â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
    private static readonly List<string> _ordenNavDefault = new()
    {
        "ventas", "crm", "catalogo", "produccion", "inventario", "planificacion", "rrhh", "admin"
    };
    private static readonly Dictionary<string, string> _nombresGrupo = new()
    {
        ["ventas"]       = "Comercial",
        ["crm"]          = "CRM",
        ["catalogo"]     = "Catálogo",
        ["produccion"]   = "Producción",
        ["inventario"]   = "Inventario",
        ["planificacion"]= "Planificación",
        ["rrhh"]         = "Recursos Humanos",
        ["admin"]        = "Administración",
    };

    private List<string> _ordenNavLocal = new();
    private bool _guardandoOrdenNav;

    private string NombreGrupo(string key) =>
        _nombresGrupo.TryGetValue(key, out var n) ? n : key;

    private void CargarOrdenNavLocal()
    {
        var guardado = Preferencias.OrdenGruposNav;
        _ordenNavLocal = guardado.Count > 0
            ? guardado.Concat(_ordenNavDefault.Except(guardado)).ToList()
            : new List<string>(_ordenNavDefault);
    }

    private void MoverGrupoArriba(int idx)
    {
        if (idx <= 0) return;
        (_ordenNavLocal[idx], _ordenNavLocal[idx - 1]) = (_ordenNavLocal[idx - 1], _ordenNavLocal[idx]);
    }

    private void MoverGrupoAbajo(int idx)
    {
        if (idx >= _ordenNavLocal.Count - 1) return;
        (_ordenNavLocal[idx], _ordenNavLocal[idx + 1]) = (_ordenNavLocal[idx + 1], _ordenNavLocal[idx]);
    }

    private async Task GuardarOrdenNavAsync()
    {
        _guardandoOrdenNav = true;
        await Preferencias.EstablecerOrdenGruposNavAsync(new List<string>(_ordenNavLocal));
        _guardandoOrdenNav = false;
        Snackbar.Add("Orden del menú guardado", Severity.Success);
    }

    private async Task RestablecerOrdenNavAsync()
    {
        _ordenNavLocal = new List<string>(_ordenNavDefault);
        await Preferencias.EstablecerOrdenGruposNavAsync(new List<string>(_ordenNavDefault));
        Snackbar.Add("Orden restablecido al predeterminado", Severity.Info);
    }

    private async Task OnTemaOscuroCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerTemaOscuroAsync(nuevoValor);
    }

    private async Task OnMostrarAyudaCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerMostrarAyudaAsync(nuevoValor);
    }

    private async Task OnMantenerSesionCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerMantenerSesionActivaAsync(nuevoValor);
        Snackbar.Add(nuevoValor
            ? "Sesion activa: el token se renovara automaticamente."
            : "Sesion normal: cerrara al vencer el token.", Severity.Info);
    }

    private int _intervaloMin     => Preferencias.IntervaloAntiestresSeg / 60;
    private int _intervaloSegExtra => Preferencias.IntervaloAntiestresSeg % 60;

    private async Task OnAntiestresActivoCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerAntiestresActivoAsync(nuevoValor);
        Snackbar.Add(nuevoValor
            ? "Modo antiestres activado 🐾 El perrito aparecera cada cierto tiempo."
            : "Modo antiestres desactivado.", Severity.Info);
    }

    private async Task OnIntervaloMinCambiadoAsync(int min)
    {
        var seg = Math.Max(0, min) * 60 + _intervaloSegExtra;
        if (seg < 10) seg = 10;
        await Preferencias.EstablecerIntervaloAntiestresSeg(seg);
    }

    private async Task OnIntervaloSegCambiadoAsync(int segExtra)
    {
        var seg = _intervaloMin * 60 + Math.Max(0, segExtra);
        if (seg < 10) seg = 10;
        await Preferencias.EstablecerIntervaloAntiestresSeg(seg);
    }

    // â"€â"€ Descanso (burbujas) â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
    private bool[] _burbujasPopped = new bool[70];
    private void ExplotarBurbuja(int idx) { if (!_burbujasPopped[idx]) _burbujasPopped[idx] = true; }
    private void ReiniciarBurbujas() => _burbujasPopped = new bool[70];

    // â"€â"€ Integraciones (Administracion) â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
    private async Task OnUsaVisionsCambiadoAsync(bool nuevoValor)
    {
        if (!nuevoValor)
        {
            var confirm = await DialogService.ShowMessageBox(
                "Desactivar integración con Visions",
                "Al desactivar Visions se ocultarán el Mapeo de Artículos, la configuración Visions en Centros de Costo y todas las menciones relacionadas. Los datos guardados no se eliminan y puedes volver a activarlo cuando quieras. ¿Confirmas?",
                yesText: "Sí, desactivar", cancelText: "Cancelar");

            if (confirm != true) return;
        }

        try
        {
            await ConfiguracionEmpresa.ActualizarUsaVisionsAsync(nuevoValor);
            Snackbar.Add(nuevoValor ? "Integracion con Visions activada." : "Integracion con Visions desactivada.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // â"€â"€ Inventario y Produccion (Administracion) â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
    private string _modoLotes = "FIFO";
    private bool _manejarVencimientos;
