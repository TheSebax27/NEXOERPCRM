                                </div>
                            </div>
                            <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Info" />
                        </div>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

        @* ── Mi Negocio (Administracion) ── *@
        else if (_seccion == "negocio")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
