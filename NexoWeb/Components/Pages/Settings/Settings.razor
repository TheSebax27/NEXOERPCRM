        @* â"€â"€ Inventario y Produccion (Administracion) â"€â"€ *@
        else if (_seccion == "inventario")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
