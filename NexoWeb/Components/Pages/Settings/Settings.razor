    private async Task GuardarPerfilAsync()
    {
        _guardandoPerfil = true;
        try
        {
            var resp = await ApiClient.PutAsync<ActualizarPerfilRequest, PerfilActualizadoResponse>(
                "api/auth/perfil", new ActualizarPerfilRequest(_perfilNombres.Trim(), _perfilApellidos.Trim()));
            await AuthState.ActualizarNombreAsync(_perfilNombres.Trim(), _perfilApellidos.Trim());
            Snackbar.Add("Datos actualizados correctamente.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoPerfil = false; }
    }

    private async Task VolverEmpleadoAsync()
    {
        _volviendoEmpleado = true;
        try
        {
            var resp = await ApiClient.PostAsync<object, RenovarResponse>("api/auth/volver-empleado", new { });
            await AuthState.ActualizarTokenYRolAsync(resp.AccessToken, resp.ExpiraEn, "Empleados");
            Snackbar.Add("Ahora eres Empleado. Las páginas protegidas se actualizarán.", Severity.Info);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _volviendoEmpleado = false; }
    }

    private async Task OnFotoPerfilSeleccionadaAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 1_000_000;
        if (e.File.Size > maxBytes)
        {
            Snackbar.Add("La imagen es muy grande (maximo 1 MB).", Severity.Warning);
            return;
        }
        _procesandoFotoPerfil = true;
        try
        {
            using var stream = e.File.OpenReadStream(maxBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var base64 = Convert.ToBase64String(memoria.ToArray());
            await ApiClient.PutAsync<ActualizarFotoPerfilRequest, object?>(
                "api/auth/perfil/foto", new ActualizarFotoPerfilRequest(base64, e.File.ContentType));
            await AuthState.ActualizarFotoAsync(base64, e.File.ContentType);
            Snackbar.Add("Foto actualizada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _procesandoFotoPerfil = false; }
    }

    private async Task QuitarFotoPerfilAsync()
    {
        _procesandoFotoPerfil = true;
        try
        {
            await ApiClient.DeleteAsync("api/auth/perfil/foto");
            await AuthState.EliminarFotoAsync();
            Snackbar.Add("Foto eliminada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _procesandoFotoPerfil = false; }
    }

