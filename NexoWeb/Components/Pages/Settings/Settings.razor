                        <MudDivider Class="my-4" />

                        <div class="d-flex align-center justify-space-between mb-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem;">Venta desde Receta</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3);">
                                    Al descontar stock de una factura, consume los insumos de la receta en vez del stock del producto terminado.
                                    <strong>No usar junto con Órdenes de Producción manuales</strong> — los modos son excluyentes.
                                </div>
                            </div>
                            <MudSwitch T="bool" Value="ConfiguracionEmpresa.VentaDesdeReceta"
