                                </div>
                            </div>
                            <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Info" />
                        </div>

                        <MudDivider Class="my-4" />

                        <div class="d-flex align-center justify-space-between mb-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem;">Sistema de Seguimiento</div>
