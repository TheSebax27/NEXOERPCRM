@using NexoWeb.Common.Dtos
@using NexoWeb.Common.ApiClient
@inject INexoApiClient Api

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center" style="gap:8px">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">Verificar stock — @Orden.CodigoOP</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Orden.Producto</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate Color="Color.Primary" />
            </div>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense>@_error</MudAlert>
            <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">
                Puedes intentar liberar de todas formas — el sistema validara el stock en ese momento.
            </MudText>
        }
        else if (_lineas.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense>No se encontraron insumos para verificar.</MudAlert>
        }
        else
        {
            @* Resumen semaforo *@
            <div class="d-flex" style="gap:12px; margin-bottom:16px; flex-wrap:wrap">
                @{
                    var ok      = _lineas.Count(l => l.Suficiente);
                    var falta   = _lineas.Count(l => !l.Suficiente);
                }
                <div style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                            background:color-mix(in srgb, var(--mud-palette-success) 12%, transparent);
                            border-radius:8px">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    <span style="font-weight:600; color:var(--mud-palette-success)">@ok OK</span>
                </div>
                @if (falta > 0)
                {
                    <div style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                                background:color-mix(in srgb, var(--mud-palette-error) 12%, transparent);
                                border-radius:8px">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                        <span style="font-weight:600; color:var(--mud-palette-error)">@falta sin stock</span>
                    </div>
                }
            </div>

            <div style="overflow-x:auto">
                <table style="width:100%; border-collapse:collapse; font-size:0.83rem">
                    <thead>
                        <tr style="background:var(--mud-palette-background-grey)">
                            <th style="padding:6px 10px; text-align:left">Insumo</th>
                            <th style="padding:6px 10px; text-align:right">Requerido</th>
                            <th style="padding:6px 10px; text-align:right">Disponible</th>
                            <th style="padding:6px 10px; text-align:center; width:60px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in _lineas)
                        {
                            <tr style="border-bottom:1px solid var(--mud-palette-lines-default)">
                                <td style="padding:6px 10px">@linea.Articulo</td>
                                <td style="padding:6px 10px; text-align:right; font-weight:600">
                                    @linea.CantidadRequerida.ToString("N3") @linea.Unidad
                                </td>
                                <td style="padding:6px 10px; text-align:right;
                                           color:@(linea.Suficiente ? "var(--mud-palette-success)" : "var(--mud-palette-error)");
                                           font-weight:600">
                                    @linea.StockDisponible.ToString("N3") @linea.Unidad
                                </td>
                                <td style="padding:6px 10px; text-align:center">
                                    @if (linea.Suficiente)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Color="Color.Success" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Error"
                                                 Color="Color.Error" Size="Size.Small" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_lineas.Any(l => !l.Suficiente))
            {
                <MudAlert Severity="Severity.Error" Dense Class="mt-3">
                    Hay insumos con stock insuficiente. Si continuas, la liberacion fallara.
                    Revisa tus bodegas antes de proceder.
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(_lineas.Any(l => !l.Suficiente) ? Color.Warning : Color.Primary)"
                   StartIcon="@Icons.Material.Filled.LockOpen"
                   Disabled="_cargando"
                   OnClick="Confirmar">
            @if (_lineas.Any(l => !l.Suficiente))
            {
                <span>Liberar de todas formas</span>
            }
            else
            {
                <span>Liberar orden</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public OrdenProduccionResumen Orden { get; set; } = default!;

    private bool _cargando = true;
    private string? _error;
    private List<LineaStock> _lineas = [];

    private class LineaStock
    {
        public string Articulo { get; set; } = "";
        public string Unidad { get; set; } = "";
        public decimal CantidadRequerida { get; set; }
        public decimal StockDisponible { get; set; }
        public bool Suficiente => StockDisponible >= CantidadRequerida;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resultado = await Api.GetAsync<List<StockLineaItem>>(
                $"api/produccion/ordenes/{Orden.OrdenProduccionID}/verificar-stock");
            _lineas = (resultado ?? []).Select(r => new LineaStock
            {
                Articulo          = r.Articulo,
                Unidad            = r.Unidad,
                CantidadRequerida = r.CantidadRequerida,
                StockDisponible   = r.StockDisponible
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _cargando = false; }
    }

    private void Confirmar() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancelar()  => MudDialog.Cancel();
}
