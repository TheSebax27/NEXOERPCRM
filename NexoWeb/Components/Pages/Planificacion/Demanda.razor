@page "/planificacion/demanda"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NexoWeb.Common.Dtos

<PageTitle>Demanda Proyectada - NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Planificación</p>
            <h1 class="nexo-page-hero__title">Demanda Proyectada</h1>
        </div>
    </div>
</div>
<InfoAyuda Texto="Forecast de producción a futuro, por artículo y mes -- distinto de las Órdenes de Producción ya creadas. Compara cuánto proyectaste contra lo que realmente se produjo ese mes (Kardex de entradas de Producto Terminado)." />

<MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AbrirCreacionAsync"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    Nueva Proyeccion
</MudButton>

@if (!_cargando && _demanda.Count > 0)
{
    @* ── KPI resumen ── *@
    <div class="dem-kpi-row mb-4">
        <div class="dem-kpi-tile">
            <span class="dem-kpi-tile__label">Proyecciones</span>
            <span class="dem-kpi-tile__value">@_demanda.Count</span>
        </div>
        <div class="dem-kpi-tile @(_cumplimientoPromedio >= 100 ? "dem-kpi-tile--ok" : _cumplimientoPromedio >= 70 ? "dem-kpi-tile--warn" : "dem-kpi-tile--risk")">
            <span class="dem-kpi-tile__label">Cumplimiento prom.</span>
            <span class="dem-kpi-tile__value">@_cumplimientoPromedio.ToString("N0")%</span>
        </div>
        <div class="dem-kpi-tile @(_enRiesgo > 0 ? "dem-kpi-tile--risk" : "dem-kpi-tile--ok")">
            <span class="dem-kpi-tile__label">En riesgo (&lt;70%)</span>
            <span class="dem-kpi-tile__value">@_enRiesgo</span>
        </div>
        <div class="dem-kpi-tile @(_cumplidas > 0 ? "dem-kpi-tile--ok" : "")">
            <span class="dem-kpi-tile__label">Cumplidas (≥100%)</span>
            <span class="dem-kpi-tile__value">@_cumplidas</span>
        </div>
    </div>
}

@if (_historico.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:8px">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Comparativo histórico (últimos 12 meses)</MudText>
        <MudTable Items="_historico" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Mes</MudTh>
                <MudTh Style="text-align:right">Cumplimiento Demanda</MudTh>
                <MudTh Style="text-align:right">Cumplimiento Venta</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Mes">@context.Periodo.ToString("MMM yyyy")</MudTd>
                <MudTd DataLabel="Cumplimiento Demanda" Style="text-align:right">
                    <span style="color:@ColorPct(context.CumplimientoDemandaPromedio)">
                        @context.CumplimientoDemandaPromedio.ToString("N0")%
                    </span>
                </MudTd>
                <MudTd DataLabel="Cumplimiento Venta" Style="text-align:right">
                    <span style="color:@ColorPct(context.CumplimientoVentaPromedio)">
                        @context.CumplimientoVentaPromedio.ToString("N0")%
                    </span>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudo cargar la demanda: @_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_demanda.Count == 0)
{
    <MudText>No hay proyecciones registradas.</MudText>
}
else
{
    <MudTable Items="_demandaOrdenada" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Mes</MudTh>
            <MudTh>Artículo</MudTh>
            <MudTh>Centro</MudTh>
            <MudTh Style="text-align:right">Proyectado</MudTh>
            <MudTh Style="text-align:right">Real</MudTh>
            <MudTh Style="min-width:180px">Cumplimiento</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var pct = context.CantidadProyectada > 0
                    ? (double)(context.CantidadReal / context.CantidadProyectada * 100)
                    : 0;
                var pctCap = Math.Min(pct, 100);
                var colorPct = pct >= 100 ? Color.Success : pct >= 70 ? Color.Warning : Color.Error;
                var esFuturo = context.Periodo > NexoWeb.Common.ColombiaClock.Today;
            }
            <MudTd DataLabel="Mes">
                <div style="font-weight:500">@context.Periodo.ToString("MMM yyyy")</div>
                @if (esFuturo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mt-1" Style="height:18px;font-size:10px">Futuro</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Artículo">
                <div style="font-weight:500;font-size:.85rem">@context.NombreArticulo</div>
                <div style="font-size:.75rem;color:var(--mud-palette-text-secondary)">@context.SkuArticulo</div>
            </MudTd>
            <MudTd DataLabel="Centro">@context.CentroCosto</MudTd>
            <MudTd DataLabel="Proyectado" Style="text-align:right;font-variant-numeric:tabular-nums">
                @context.CantidadProyectada.ToString("N2")
            </MudTd>
            <MudTd DataLabel="Real" Style="text-align:right;font-variant-numeric:tabular-nums">
                @if (esFuturo)
                {
                    <span style="color:var(--mud-palette-text-secondary)">—</span>
                }
                else
                {
                    @context.CantidadReal.ToString("N2")
                }
            </MudTd>
            <MudTd DataLabel="Cumplimiento">
                @if (esFuturo)
                {
                    <span style="color:var(--mud-palette-text-secondary);font-size:.8rem">Pendiente</span>
                }
                else
                {
                    <div class="d-flex align-center" style="gap:6px">
                        <div style="flex:1">
                            <MudProgressLinear Value="@pctCap" Color="@colorPct"
                                              Rounded="true" Size="Size.Small" />
                        </div>
                        <span style="font-size:.8rem;font-weight:600;min-width:38px;text-align:right;color:@(pct >= 100 ? "var(--mud-palette-success)" : pct >= 70 ? "var(--mud-palette-warning)" : "var(--mud-palette-error)")">
                            @pct.ToString("N0")%
                        </span>
                    </div>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" OnClick="@(() => AbrirEdicionAsync(context))">Editar</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<DemandaProyectadaItem> _demanda = new();
    private List<CentroCostoItem> _centrosCosto = new();
    private List<HistoricoCumplimientoItem> _historico = new();
    private bool _cargando = true;
    private string? _errorCarga;

    private IEnumerable<DemandaProyectadaItem> _demandaOrdenada =>
        _demanda.OrderByDescending(d => d.Periodo).ThenBy(d => d.NombreArticulo);

    private double _cumplimientoPromedio => _demanda.Count == 0 ? 0 :
        _demanda.Where(d => d.CantidadProyectada > 0 && d.Periodo <= NexoWeb.Common.ColombiaClock.Today)
                .Select(d => (double)(d.CantidadReal / d.CantidadProyectada * 100))
                .DefaultIfEmpty(0).Average();

    private int _enRiesgo => _demanda.Count(d =>
        d.CantidadProyectada > 0 && d.Periodo <= NexoWeb.Common.ColombiaClock.Today &&
        d.CantidadReal / d.CantidadProyectada * 100 < 70);

    private int _cumplidas => _demanda.Count(d =>
        d.CantidadProyectada > 0 && d.Periodo <= NexoWeb.Common.ColombiaClock.Today &&
        d.CantidadReal >= d.CantidadProyectada);

    private string ColorPct(decimal pct) =>
        pct >= 100 ? "var(--mud-palette-success)" :
        pct >= 70  ? "var(--mud-palette-warning)" :
                     "var(--mud-palette-error)";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaCentros     = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo?soloActivos=true");
            var tareaDemanda     = ApiClient.GetAsync<List<DemandaProyectadaItem>>("api/planificacion/demanda");
            var tareaHistorico   = ApiClient.GetAsync<List<HistoricoCumplimientoItem>>("api/planificacion/historico-cumplimiento?meses=12");

            await Task.WhenAll(tareaCentros, tareaDemanda, tareaHistorico);

            _centrosCosto = await tareaCentros  ?? new();
            _demanda      = await tareaDemanda  ?? new();
            _historico    = await tareaHistorico ?? new();
        }
        catch (Exception ex) { _errorCarga = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task CargarDemandaAsync()
    {
        try { _demanda = await ApiClient.GetAsync<List<DemandaProyectadaItem>>("api/planificacion/demanda") ?? new(); }
        catch (Exception ex) { _errorCarga = ex.Message; }
    }

    private async Task AbrirCreacionAsync()
    {
        var parametros = new DialogParameters<DemandaDialog>
        {
            { x => x.CentrosCosto, _centrosCosto }
        };
        var dialogo = await DialogService.ShowAsync<DemandaDialog>("Nueva Proyeccion de Demanda", parametros);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;
        try
        {
            await ApiClient.PostAsync<CrearDemandaRequest, object?>("api/planificacion/demanda", (CrearDemandaRequest)resultado.Data!);
            Snackbar.Add("Proyeccion creada correctamente.", Severity.Success);
            await CargarDemandaAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AbrirEdicionAsync(DemandaProyectadaItem demanda)
    {
        var parametros = new DialogParameters<DemandaDialog> { { x => x.Demanda, demanda } };
        var dialogo = await DialogService.ShowAsync<DemandaDialog>("Editar Proyeccion", parametros);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;
        try
        {
            await ApiClient.PutAsync<ActualizarDemandaRequest, object?>(
                $"api/planificacion/demanda/{demanda.DemandaID}", (ActualizarDemandaRequest)resultado.Data!);
            Snackbar.Add("Proyeccion actualizada correctamente.", Severity.Success);
            await CargarDemandaAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
