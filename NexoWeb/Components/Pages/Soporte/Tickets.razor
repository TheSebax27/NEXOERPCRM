    private static string EstadoLabel(string e) => e switch
    {
        "ABIERTO"     => "Abierto",
        "EN_PROGRESO" => "En Proceso",
        "RESUELTO"    => "Resuelto",
        "CERRADO"     => "Cerrado",
        _             => e
    };

    private static string ComentarioClass(bool esInterno) =>
        esInterno ? "sop-comment sop-comment--interno" : "sop-comment";

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2
            ? $"{partes[0][0]}{partes[1][0]}"
            : nombre.Length > 0 ? nombre[..1] : "?";
    }

    private async Task AbrirDetalle(TicketItem t)
    {
        _resolverMode = false;
        _resolverNotas = string.Empty;
        _ticketSeleccionado = t;
        _drawerAbierto = true;
        _comentarios = (await Api.GetAsync<List<TicketComentarioItem>>($"api/soporte/tickets/{t.TicketID}/comentarios") ?? []);
    }

    private async Task CambiarEstado(int ticketId, string estado)
    {
        _cambiandoEstado = true;
        await Api.PatchAsync<CambiarEstadoTicketRequest, object>(
            $"api/soporte/tickets/{ticketId}/estado",
            new CambiarEstadoTicketRequest(estado));
        Snackbar.Add("Estado actualizado", Severity.Success);
        _cambiandoEstado = false;
        await Cargar();
        if (_ticketSeleccionado?.TicketID == ticketId)
            _ticketSeleccionado = _tickets.FirstOrDefault(t => t.TicketID == ticketId);
    }

    private async Task ConfirmarResolucion()
    {
        if (_ticketSeleccionado is null) return;
        _cambiandoEstado = true;

        await Api.PatchAsync<CambiarEstadoTicketRequest, object>(
            $"api/soporte/tickets/{_ticketSeleccionado.TicketID}/estado",
            new CambiarEstadoTicketRequest("RESUELTO"));

        if (!string.IsNullOrWhiteSpace(_resolverNotas))
        {
            await Api.PostAsync($"api/soporte/tickets/{_ticketSeleccionado.TicketID}/comentarios",
                new CrearTicketComentarioRequest(_resolverNotas, false));
            _comentarios = (await Api.GetAsync<List<TicketComentarioItem>>(
                $"api/soporte/tickets/{_ticketSeleccionado.TicketID}/comentarios") ?? []);
        }

        _resolverMode = false;
        _resolverNotas = string.Empty;
        _cambiandoEstado = false;
        Snackbar.Add("Ticket marcado como resuelto", Severity.Success);

        // Mostrar encuesta NPS automáticamente
        _npsPuntuacion = -1;
        _npsComentario = string.Empty;
        _npsMode = true;

        await Cargar();
        _ticketSeleccionado = _tickets.FirstOrDefault(t => t.TicketID == _ticketSeleccionado?.TicketID);
    }

    private async Task EnviarNps()
    {
        if (_ticketSeleccionado is null || _npsPuntuacion < 0) return;
        await Api.PostAsync($"api/soporte/tickets/{_ticketSeleccionado.TicketID}/nps",
            new { Puntuacion = _npsPuntuacion, Comentario = _npsComentario });
        _npsMode = false;
        Snackbar.Add("¡Gracias por tu valoración!", Severity.Success);
    }

    private void OmitirNps() { _npsMode = false; }

    private async Task EnviarWhatsApp()
    {
        if (string.IsNullOrWhiteSpace(_waPhone) || string.IsNullOrWhiteSpace(_waMensaje)) return;
        _enviandoWa = true;
        try
        {
            await Api.PostAsync("api/whatsapp/enviar",
                new { Telefono = _waPhone, Mensaje = _waMensaje });
            Snackbar.Add("Mensaje enviado por WhatsApp.", Severity.Success);
            _whatsappMode = false;
            _waPhone = string.Empty;
            _waMensaje = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al enviar: {ex.Message}", Severity.Error);
        }
        _enviandoWa = false;
    }

    private async Task AbrirCrear()
    {
        var dlg = await Dialogs.ShowAsync<TicketDialog>("Nuevo Ticket", new DialogParameters
        {
            ["Modo"] = "crear"
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dlg.Result;
        if (result is { Canceled: false } && result.Data is CrearTicketRequest req)
        {
            await Api.PostAsync("api/soporte/tickets", req);
            Snackbar.Add("Ticket creado", Severity.Success);
            await Cargar();
        }
    }

    private async Task AbrirEditar(TicketItem t)
    {
        var dlg = await Dialogs.ShowAsync<TicketDialog>("Editar Ticket", new DialogParameters
        {
            ["Modo"] = "editar",
            ["Ticket"] = t
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dlg.Result;
        if (result is { Canceled: false } && result.Data is ActualizarTicketRequest req)
        {
            await Api.PutAsync($"api/soporte/tickets/{t.TicketID}", req);
            Snackbar.Add("Ticket actualizado", Severity.Success);
            await Cargar();
            _ticketSeleccionado = _tickets.FirstOrDefault(x => x.TicketID == t.TicketID);
        }
    }

    private async Task EnviarComentario()
    {
        if (_ticketSeleccionado is null || string.IsNullOrWhiteSpace(_nuevoComentario)) return;
        var req = new CrearTicketComentarioRequest(_nuevoComentario, _comentarioInterno);
        await Api.PostAsync($"api/soporte/tickets/{_ticketSeleccionado.TicketID}/comentarios", req);
        _nuevoComentario = string.Empty;
        _comentarioInterno = false;
        _comentarios = (await Api.GetAsync<List<TicketComentarioItem>>($"api/soporte/tickets/{_ticketSeleccionado.TicketID}/comentarios") ?? []);
        Snackbar.Add("Comentario enviado", Severity.Success);
    }
}
