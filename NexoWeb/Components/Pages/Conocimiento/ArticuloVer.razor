@page "/conocimiento/{ArticuloID:int}"
@attribute [Authorize]
@inject INexoApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_articulo?.Titulo ?? "Artículo") | NEXO ERP</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="d-block mx-auto mt-8" />
}
else if (_articulo is null)
{
    <MudAlert Severity="Severity.Error">Artículo no encontrado.</MudAlert>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/conocimiento"))" Size="Size.Small" Class="mb-3">
            Base de Conocimiento
        </MudButton>

        <div class="d-flex align-center gap-2 mb-1">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @_articulo.Categoria
            </MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_articulo.Vistas 👁 · Actualizado @_articulo.FechaActualizacion.ToString("dd/MM/yyyy")
            </MudText>
        </div>

        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@_articulo.Titulo</MudText>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-4">
            Por @_articulo.AutorNombre
            @if (!string.IsNullOrWhiteSpace(_articulo.Tags))
            { <span class="ml-3">🏷 @_articulo.Tags</span> }
        </MudText>

        <MudPaper Class="pa-5" Elevation="0"
                  Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px;white-space:pre-wrap;line-height:1.7">
            @_articulo.Contenido
        </MudPaper>

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Nav.NavigateTo($"/conocimiento/{ArticuloID}/editar"))">
                Editar
            </MudButton>
        </div>
    </MudContainer>
}

@code {
    [Parameter] public int ArticuloID { get; set; }

    private ArticuloItem? _articulo;
    private bool _cargando = true;

    private record ArticuloItem(
        int ArticuloID, string Titulo, string Contenido, string Categoria,
        string? Tags, int AutorID, string? AutorNombre,
        DateTime FechaCreacion, DateTime FechaActualizacion, bool Activo, int Vistas);

    protected override async Task OnInitializedAsync()
    {
        _articulo = await Api.GetAsync<ArticuloItem>($"api/conocimiento/{ArticuloID}");
        _cargando = false;
    }
}
