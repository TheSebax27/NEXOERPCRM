            StateHasChanged();
        }
    }

    private async Task CargarResumenGeneralAsync()
    {
        // Todas las llamadas en paralelo — sin esperas secuenciales
        var tCrm         = ApiClient.GetAsync<ResumenCrmItem>($"api/dashboard/resumen-crm?desde={NexoWeb.Common.ColombiaClock.Today.AddDays(-30):yyyy-MM-dd}&hasta={NexoWeb.Common.ColombiaClock.Today:yyyy-MM-dd}");
        var tFrios        = ApiClient.GetAsync<List<ClienteFrioItem>>("api/crm/clientes-frios?diasSinContacto=30");
        var tVentasDept   = ApiClient.GetAsync<List<VentasPorDepartamentoItem>>("api/dashboard/ventas-por-departamento");
        var tEmpleados    = ApiClient.GetAsync<List<EmpleadosPorCentroCostoItem>>("api/dashboard/empleados-por-centro-costo");
        var tCartera      = ApiClient.GetAsync<FacturasPaginadasResponse>("api/facturacion/facturas?soloNoPagadas=true&pagina=1&tamano=200");
        var tPlanif       = ApiClient.GetAsync<ResumenPlanificacionItem>("api/dashboard/resumen-planificacion");
        var tInventario   = ApiClient.GetAsync<ResumenInventarioItem>("api/dashboard/resumen-inventario");
        var tDesviaciones = ApiClient.GetAsync<List<DesviacionItem>>("api/planificacion/desviaciones?umbral=70");
        var tAlertas      = ApiClient.GetAsync<List<ProyectoAlertaItem>>("api/proyectos/alertas");
        var tEvento       = ApiClient.GetAsync<EventoCalendarioItem>("api/calendario/eventos/proximo");
        var tMaquinaria   = ApiClient.GetAsync<ResumenMaquinariaItem>("api/dashboard/resumen-maquinaria");

        try { await Task.WhenAll(tCrm, tFrios, tVentasDept, tEmpleados, tCartera,
                                 tPlanif, tInventario, tDesviaciones, tAlertas, tEvento, tMaquinaria); }
        catch { /* individual awaits below manejan cada fallo */ }

        try
        {
            _resumenCrm              = await tCrm        ?? new(0, 0);
            _clientesFrios           = await tFrios       ?? new();
            _ventasDept              = await tVentasDept  ?? new();
            _empleadosPorCentroCosto = await tEmpleados   ?? new();
            _totalEmpleadosActivos   = _empleadosPorCentroCosto.Sum(e => e.TotalEmpleados);
            var carteraItems         = (await tCartera)?.Items ?? new();
            _cartera                 = carteraItems.Take(5).ToList();
            _totalSaldoCartera       = carteraItems.Sum(f => f.SaldoPendiente);
        }
        catch (HttpRequestException) { }

        try
        {
            _resumenPlanificacion = await tPlanif       ?? new(0, 0);
            _resumenInventario    = await tInventario   ?? new(0, 0);
            _desviaciones         = await tDesviaciones ?? new();
            _alertasProyectos     = await tAlertas      ?? new();
        }
        catch { }

        try { _proximoEvento   = await tEvento;    } catch { }
        try { _resumenMaquinaria = await tMaquinaria; } catch { }

        // ── Actividad, sparklines y estado del agente ──────────────────────
        try
        {
            var tareaActividad  = ApiClient.GetAsync<List<ActividadFeedItem>>("api/dashboard/actividad?n=15");
            var tareaSparklines = ApiClient.GetAsync<SparklinesDashboard>("api/dashboard/sparklines");
            if (ConfiguracionEmpresa.UsaVisions)
            {
                var tareaAgente = ApiClient.GetAsync<List<EstadoIntegracionResponse>>("api/integracion/estado");
                await Task.WhenAll(tareaActividad, tareaSparklines, tareaAgente);
                _estadoAgente = (await tareaAgente)?.OrderByDescending(a => a.UltimoLatido).FirstOrDefault();
            }
            else
            {
                await Task.WhenAll(tareaActividad, tareaSparklines);
            }
            _actividad  = await tareaActividad  ?? new();
            _sparklines = await tareaSparklines;
        }
        catch { }

        // Timer para refrescar actividad cada 60 s
        _timerActividad = new System.Timers.Timer(60_000);
        _timerActividad.Elapsed += async (_, _) =>
        {
            try { _actividad = await ApiClient.GetAsync<List<ActividadFeedItem>>("api/dashboard/actividad?n=15") ?? new(); }
            catch { }
            await InvokeAsync(StateHasChanged);
        };
        _timerActividad.AutoReset = true;
        _timerActividad.Start();
    }

