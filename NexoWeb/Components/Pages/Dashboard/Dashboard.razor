    private static string LabelColumna(string col) =>
        _colLabels.TryGetValue(col, out var label) ? label : col;

    private static bool EsColumnaNumerica(string col)
    {
        var u = col.ToUpperInvariant();
        return u is "STOCK" or "STOCKMINIMO" or "CANTIDAD" or "CANTIDADNEXO" or "CANTIDADVISIONS"
                or "CANTIDADTOTAL" or "CANTIDADVENDIDA" or "CANTIDADPROGRAMADA" or "CANTIDADPRODUCIDA"
                or "CANTIDADTEORICA" or "CANTIDADREAL" or "ENTRADA" or "SALIDA" or "SALDO"
                or "NUMDOCUMENTOS" or "DIASPARADO" or "DIASINVENTARIO" or "TOTAL" or "PROMOTORES"
                or "DETRACTORES" or "MES" or "ANIO"
            || u.StartsWith("TOTAL") || u.StartsWith("VALOR") || u.StartsWith("COSTO")
            || u.StartsWith("PRECIO") || u.StartsWith("UTILIDAD") || u.Contains("PCT")
            || u.Contains("MARGEN") || u.Contains("DESVIACION") || u.Contains("ROTACION")
            || u.Contains("UNIDADES") || u.Contains("FACTURAS");
    }

    private static string FormatValReporte(object? val, string col)
    {
        if (val is null) return "-";
        double? num = null;
        DateTime? dt = null;
        string? str = null;

        if (val is JsonElement je)
        {
            switch (je.ValueKind)
            {
                case JsonValueKind.Number: num = je.GetDouble(); break;
                case JsonValueKind.String:
                    var s = je.GetString() ?? "";
                    if (DateTime.TryParse(s, out var d)) dt = d;
                    else str = s;
                    break;
                case JsonValueKind.Null: return "-";
                default: str = je.ToString(); break;
            }
        }
        else if (val is decimal dec) num = (double)dec;
        else if (val is double dbl)  num = dbl;
        else if (val is int  i)      num = i;
        else if (val is long l)      num = l;
        else if (val is DateTime datetime) dt = datetime;
        else str = val.ToString();

        if (dt.HasValue) return dt.Value.ToString("dd/MM/yyyy");
        if (num.HasValue)
        {
            var u = col.ToUpperInvariant();
            if (u.Contains("PCT") || u.Contains("MARGEN") || u.Contains("DESVIACION"))
                return num.Value.ToString("N1") + " %";
            if (u.Contains("ROTACION"))
                return num.Value.ToString("N2");
            if (u is "DIASPARADO" or "DIASINVENTARIO" or "NUMDOCUMENTOS" or "MES" or "ANIO"
                  or "TOTAL" or "PROMOTORES" or "DETRACTORES")
                return num.Value.ToString("N0");
            if (u.StartsWith("TOTAL") || u.StartsWith("VALOR") || u.StartsWith("COSTO")
                || u.StartsWith("PRECIO") || u.StartsWith("UTILIDAD") || u.Contains("VENTA"))
                return "$ " + num.Value.ToString("N0");
            return num.Value.ToString("N2");
        }
        return str ?? "-";
    }

    private async Task CargarListaReportesAsync()
    {
        try
        {
            var lista = await ApiClient.GetAsync<List<RptInfo>>("api/reportes") ?? new();
            _rptLista = lista;
            if (_rptLista.Count > 0 && _rptTipo is null)
                _rptTipo = _rptLista[0].Tipo;
        }
        catch { }
    }

    private async Task EjecutarReporteAsync()
    {
        if (_rptTipo is null) return;
        _rptCargando = true;
        _rptFilas    = new();
        StateHasChanged();
        try
        {
            var req = new { Tipo = _rptTipo, Desde = _rptDesde, Hasta = _rptHasta, Limite = 500, Filtro = _rptFiltro };
            _rptFilas = await ApiClient.PostAsync<object, List<Dictionary<string, object?>>>("api/reportes/ejecutar", req) ?? new();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _rptCargando = false; _rptEjecutado = true; }
    }

    private async Task ExportarReporteExcelAsync()
    {
        if (_rptTipo is null) return;
        try
        {
            var req    = new { Tipo = _rptTipo, Desde = _rptDesde, Hasta = _rptHasta, Limite = 500, Filtro = _rptFiltro };
            var bytes  = await ApiClient.PostBytesAsync<object>("api/reportes/exportar", req);
            var nombre = $"reporte_{_rptTipo}_{NexoWeb.Common.ColombiaClock.Today:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("nexoDescargarArchivo", nombre,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error); }
    }

    private async Task ExportarReportePdfAsync()
    {
        if (_rptTipo is null) return;
        try
        {
            var req    = new { Tipo = _rptTipo, Desde = _rptDesde, Hasta = _rptHasta, Limite = 500, Filtro = _rptFiltro };
            var bytes  = await ApiClient.PostBytesAsync<object>("api/reportes/exportar-pdf", req);
            var nombre = $"reporte_{_rptTipo}_{NexoWeb.Common.ColombiaClock.Today:yyyy-MM-dd}.pdf";
            await JS.InvokeVoidAsync("nexoDescargarArchivo", nombre, "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Snackbar.Add($"Error al exportar PDF: {ex.Message}", Severity.Error); }
    }
