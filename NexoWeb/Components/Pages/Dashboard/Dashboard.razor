        </MudTabPanel>

        @* ══════════════════════════════════════════════ TAB REPORTES ══ *@
        <MudTabPanel Text="Reportes" Icon="@Icons.Material.Outlined.Assessment">

            <div class="nexo-section" style="margin-top:0.25rem">
                <div class="nexo-section__dot" style="background:#8B5CF6"></div>
                <span class="nexo-section__label">Centro de Reportes</span>
                <div class="nexo-section__line"></div>
            </div>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)" Class="mb-4">
                Ejecuta reportes predefinidos y exporta los datos a Excel con el rango de fechas que necesites.
            </MudText>

            @* Controles *@
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <AppSelect TValue="string" @bind-Value="_rptTipo" Label="Tipo de reporte"
                                   Items="@(_rptLista.Select(r => new AppSelectItem<string>(r.Nombre, r.Tipo)))" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudDatePicker @bind-Date="_rptDesde" Label="Desde" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudDatePicker @bind-Date="_rptHasta" Label="Hasta" Variant="Variant.Outlined" />
                    </MudItem>
                    @if (_rptTipo == "kardex_individual")
                    {
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_rptFiltro" Label="Referencia o nombre del artículo"
                                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Search" />
                        </MudItem>
                    }
                </MudGrid>
                <div class="d-flex mt-3" style="gap:8px">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.PlayArrow"
                               OnClick="EjecutarReporteAsync" Disabled="_rptCargando">
                        @(_rptCargando ? "Ejecutando…" : "Ejecutar reporte")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.GridOn"
                               OnClick="ExportarReporteExcelAsync"
                               Disabled="@(_rptCargando || _rptFilas.Count == 0)">
                        Excel
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="ExportarReportePdfAsync"
                               Disabled="@(_rptCargando || _rptFilas.Count == 0)">
                        PDF
                    </MudButton>
                    @if (_rptFilas.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="align-self:center">
                            @_rptFilas.Count filas
                        </MudChip>
                    }
                </div>
                @if (_rptTipo is not null)
                {
                    var desc = _rptLista.FirstOrDefault(r => r.Tipo == _rptTipo)?.Descripcion;
                    if (!string.IsNullOrEmpty(desc))
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)" Class="mt-2">@desc</MudText>
                    }
                }
            </MudPaper>

            @* Resultado *@
            @if (_rptCargando)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else if (_rptFilas.Count > 0)
            {
                var columnas = _rptFilas[0].Keys.ToList();
                <MudPaper Class="pa-0" Style="overflow:hidden;border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                    <div class="d-flex align-center pa-4 pb-3" style="border-bottom:1px solid var(--mud-palette-lines-default);gap:10px">
                        <MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Style="color:var(--mud-palette-primary)" />
                        <div class="flex-grow-1">
                            <div style="font-weight:700;font-size:0.95rem">@(_rptLista.FirstOrDefault(r => r.Tipo == _rptTipo)?.Nombre)</div>
                            <div style="font-size:0.78rem;color:var(--mud-palette-text-secondary)">
                                @_rptDesde?.ToString("dd/MM/yyyy") — @_rptHasta?.ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrEmpty(_rptFiltro) && _rptTipo == "kardex_individual")
                                { <span> · Filtro: <strong>@_rptFiltro</strong></span> }
                            </div>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                        <MudTable Items="_rptFilas" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="460px"
                                  Style="--mud-table-striped-background:rgba(99,102,241,0.04)">
                            <HeaderContent>
                                @foreach (var col in columnas)
                                {
                                    var isNum = EsColumnaNumerica(col);
                                    <MudTh Style="@(isNum ? "text-align:right;white-space:nowrap" : "white-space:nowrap")">
                                        @LabelColumna(col)
                                    </MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                @foreach (var col in columnas)
                                {
                                    var val  = context.TryGetValue(col, out var v) ? v : null;
                                    var fmt  = FormatValReporte(val, col);
                                    var isNum = EsColumnaNumerica(col);
                                    var esNeg = isNum && fmt.StartsWith("-");
                                    var esPos = col.ToUpperInvariant().Contains("MARGEN") || col.ToUpperInvariant().Contains("UTILIDAD");
                                    <MudTd DataLabel="@LabelColumna(col)"
                                           Style="@(isNum ? "text-align:right;font-variant-numeric:tabular-nums" : "")">
                                        @if (esNeg)
                                        {
                                            <span style="color:#EF4444">@fmt</span>
                                        }
                                        else if (esPos && isNum && fmt != "-" && fmt != "0 %")
                                        {
                                            <span style="color:#10B981;font-weight:600">@fmt</span>
                                        }
                                        else
                                        {
                                            @fmt
                                        }
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudPaper>
            }
            else if (!_rptCargando && _rptEjecutado)
            {
                <div class="nexo-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Class="nexo-empty-state__icon" />
                    <p class="nexo-empty-state__text">Sin datos para el período y filtros seleccionados.</p>
                </div>
            }
            else if (!_rptEjecutado)
            {
                <MudPaper Class="pa-10 d-flex flex-column align-center justify-center" style="min-height:220px;border:1px dashed var(--mud-palette-lines-default);border-radius:12px;opacity:.75">
                    <MudIcon Icon="@Icons.Material.Outlined.Assessment" Style="font-size:3.5rem;color:var(--mud-palette-primary);margin-bottom:16px" />
                    <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:4px">Centro de Reportes</MudText>
                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">Selecciona un reporte y haz clic en <strong>Ejecutar reporte</strong>.</MudText>
                </MudPaper>
            }

        </MudTabPanel>

    </MudTabs>
}

