            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }

    public void Dispose()
    {
        Modulos.OnCambio -= VerificarAccesoBI;
        _timerActividad?.Stop();
        _timerActividad?.Dispose();
    }

    private void VerificarAccesoBI()
    {
        if (!Modulos.Cargado || Modulos.EsAdmin) return;
        if (Modulos.EsVisible("BI")) return;
        foreach (var (codigo, ruta) in _rutasAlternativas)
        {
            if (Modulos.EsVisible(codigo))
            {
                Navigation.NavigateTo(ruta, replace: true);
                return;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaPlanVsReal    = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_planDesde:yyyy-MM-dd}&hasta={_planHasta:yyyy-MM-dd}");
            var tareaVariacion     = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_varDesde:yyyy-MM-dd}&hasta={_varHasta:yyyy-MM-dd}");
            var tareaDistribucion  = ApiClient.GetAsync<List<DistribucionCentroCostoItem>>("api/dashboard/distribucion-centro-costo");
            var tareaPerdidas      = ApiClient.GetAsync<List<PerdidaPorMotivoItem>>(
                $"api/dashboard/perdidas-por-motivo?desde={_perdDesde:yyyy-MM-dd}&hasta={_perdHasta:yyyy-MM-dd}");
            var tareaConteoArticulos = ApiClient.GetAsync<int>("api/catalogo/articulos/count?estado=true");
            var tareaCumplimiento    = ApiClient.GetAsync<List<CumplimientoCentroCostoItem>>("api/dashboard/cumplimiento-planificacion");

            await Task.WhenAll(tareaPlanVsReal, tareaVariacion, tareaDistribucion, tareaPerdidas, tareaConteoArticulos, tareaCumplimiento);

            // Cargar articulos en segundo plano — no bloquea el render inicial del Dashboard
            _ = Task.Run(async () =>
            {
                try
                {
                    var todos = await ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos/todos?estado=true") ?? new();
                    _productosTerminados = todos.Where(a => a.TipoArticulo == "Producto Terminado").ToList();
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            });

            _planVsReal = await tareaPlanVsReal ?? new();
            ActualizarGraficoPlanVsReal();

            var variacionDatos = await tareaVariacion ?? new();
            _variacionProduccion = variacionDatos
                .Select(p => (p.Fecha,
                    Porcentaje: p.TotalPlanificado > 0 ? (double)((p.TotalReal - p.TotalPlanificado) / p.TotalPlanificado * 100) : 0d,
                    SinPlan: p.TotalPlanificado == 0 && p.TotalReal > 0))
                .ToList();

            _distribucion = await tareaDistribucion ?? new();
            _labelsDistribucion = _distribucion.Select(d => d.CentroCosto).ToArray();
            _dataDistribucion   = _distribucion.Select(d => (double)d.TotalUnidadesProducidas).ToArray();

            _perdidas = await tareaPerdidas ?? new();
            ActualizarGraficoPerdidas();

            _totalArticulosActivos  = await tareaConteoArticulos;
            _cumplimiento = await tareaCumplimiento ?? new();

            _totalOrdenesFinalizadas = _cumplimiento.Sum(c => c.TotalOrdenesFinalizadas);
            _totalOrdenesATiempo     = _cumplimiento.Sum(c => c.OrdenesATiempo);
            _cumplimientoPromedio    = _cumplimiento.Count > 0 ? (double)_cumplimiento.Average(c => c.PorcentajeCumplimiento) : 0;
            _totalRealProducido      = _seriesPlanVsReal.FirstOrDefault(s => s.Name == "Real")?.Data.Sum() ?? 0;
        }
        catch (Exception ex)
        {
