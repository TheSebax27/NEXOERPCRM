    private MarkupString SparklineSvg(List<SparklineItem> data)
    {
        if (data.Count == 0) return (MarkupString)"";
        var max = (double)data.Max(x => x.Valor);
        if (max == 0) max = 1;
        const int w = 80; const int h = 24;
        var pts = data.Select((x, i) =>
            $"{i * w / Math.Max(data.Count - 1, 1)},{h - (double)x.Valor / max * h}");
        return (MarkupString)$"""
            <svg width="{w}" height="{h}" viewBox="0 0 {w} {h}">
              <polyline points="{string.Join(" ", pts)}" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
            </svg>
            """;
    }

