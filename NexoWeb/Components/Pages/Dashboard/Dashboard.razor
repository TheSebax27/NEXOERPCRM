                                <MudTd Style="text-align:right;font-weight:600;color:#10B981">@context.TotalFacturado.ToString("C0")</MudTd>
                                <MudTd Style="text-align:right;font-size:0.82rem;color:#F43F5E">@context.CostoEstimado.ToString("C0")</MudTd>
                                <MudTd Style="text-align:right"><span style="@($"font-weight:700;color:{(context.MargenBruto >= 0 ? "#10B981" : "#EF4444")}")">@context.MargenBruto.ToString("C0")</span></MudTd>
                                <MudTd Style="text-align:right">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.PorcentajeMargen >= 30 ? Color.Success : context.PorcentajeMargen >= 15 ? Color.Warning : Color.Error)">
                                        @context.PorcentajeMargen.ToString("N1")%
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>

                @if (_gastosCategoria.Count > 0)
                {
                    <div class="nexo-section"><div class="nexo-section__dot" style="background:#F59E0B"></div><span class="nexo-section__label">Gastos operativos por categoría</span><div class="nexo-section__line"></div></div>
                    <MudPaper Class="pa-5 mb-4">
                        <MudTable Items="_gastosCategoria" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Categoría</MudTh>
                                <MudTh Style="text-align:right">Registros</MudTh>
                                <MudTh Style="text-align:right">Total</MudTh>
                                <MudTh Style="text-align:right">% del gasto</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Categoria</MudTd>
                                <MudTd Style="text-align:right;font-size:0.82rem;color:#9B9BB4">@context.Cantidad</MudTd>
                                <MudTd Style="text-align:right;font-weight:600;color:#F59E0B">@context.Total.ToString("C0")</MudTd>
                                <MudTd Style="text-align:right">
                                    @{ var pctGasto = FinTotalGastos > 0 ? (context.Total / FinTotalGastos * 100) : 0; }
