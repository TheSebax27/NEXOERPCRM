    private async Task CargarChartsVisionsAsync()
    {
        _cargandoChartsVisions = true;
        StateHasChanged();
        try
        {
            var desde = NexoWeb.Common.ColombiaClock.Today.AddDays(-30);
            var hasta = NexoWeb.Common.ColombiaClock.Today;
            var reqPeriodo = new { Tipo = "ventas_por_periodo", Desde = desde, Hasta = hasta, Limite = 100 };
            var reqTop     = new { Tipo = "top_articulos",      Desde = desde, Hasta = hasta, Limite = 20 };
            var t1 = ApiClient.PostAsync<object, List<Dictionary<string, object?>>>("api/reportes/ejecutar", reqPeriodo);
            var t2 = ApiClient.PostAsync<object, List<Dictionary<string, object?>>>("api/reportes/ejecutar", reqTop);
            await Task.WhenAll(t1, t2);

            var rowsPeriodo = await t1 ?? new();
            var rowsTop     = await t2 ?? new();

            static double Num(Dictionary<string, object?> r, string k)
            {
                if (!r.TryGetValue(k, out var v) || v is null) return 0d;
                if (v is JsonElement je) return je.ValueKind == JsonValueKind.Number ? je.GetDouble() : 0d;
                return Convert.ToDouble(v);
            }
            static string Str(Dictionary<string, object?> r, string k)
            {
                if (!r.TryGetValue(k, out var v) || v is null) return "";
                if (v is JsonElement je) return je.GetString() ?? je.ToString();
                return v.ToString() ?? "";
            }
            static DateTime FechaD(Dictionary<string, object?> r)
            {
                if (r.TryGetValue("Fecha", out var v))
                {
                    if (v is DateTime dt) return dt;
                    if (v is JsonElement je && je.TryGetDateTime(out var d)) return d;
                    if (v is string s && DateTime.TryParse(s, out var d2)) return d2;
                }
                return DateTime.MinValue;
            }

            // Gráfica 1: ventas por día
            _labelsVentasDia = rowsPeriodo.Select(r => FechaD(r).ToString("dd/MM")).ToArray();
            _seriesVentasDia = new List<ChartSeries>
            {
                new() { Name = "NEXO",    Data = rowsPeriodo.Select(r => Num(r, "TotalNEXO")).ToArray() },
                new() { Name = "Visions", Data = rowsPeriodo.Select(r => Num(r, "TotalVisions")).ToArray() },
            };

            // Gráfica 3: top artículos vendidos
            _topArtVendidos = rowsTop.Select(r => new TopArtVendido(
                Str(r, "Articulo"), Str(r, "SKU"),
                Num(r, "CantidadTotal"),  Str(r, "CanalPrincipal")
            )).ToList();

            // Gráfica 4: ventas por semana apiladas
            var semanas = rowsPeriodo
                .GroupBy(r => { var d = FechaD(r); return d == DateTime.MinValue ? d : d.AddDays(-(int)d.DayOfWeek); })
                .Where(g => g.Key != DateTime.MinValue)
                .OrderBy(g => g.Key)
                .ToList();
            _labelsNexoVsVisions = semanas.Select(g => g.Key.ToString("dd/MM")).ToArray();
            _seriesNexoVsVisions = new List<ChartSeries>
            {
                new() { Name = "NEXO",    Data = semanas.Select(g => g.Sum(r => Num(r, "TotalNEXO"))).ToArray() },
                new() { Name = "Visions", Data = semanas.Select(g => g.Sum(r => Num(r, "TotalVisions"))).ToArray() },
            };
        }
        catch { }
        finally
        {
            _cargandoChartsVisions = false;
            _chartsVisionesPendientes = true;
        }
    }

