                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="2" Style="font-weight:700">Total gastos operativos</MudTd>
                                <MudTd Style="text-align:right;font-weight:700;color:#F59E0B">@FinTotalGastos.ToString("C0")</MudTd>
                                <MudTd></MudTd>
                            </FooterContent>
                        </MudTable>
                    </MudPaper>
                }
