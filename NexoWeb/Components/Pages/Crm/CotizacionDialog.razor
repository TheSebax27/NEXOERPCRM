@using NexoWeb.Common.Dtos
@inject ISnackbar Snackbar
@inject NexoWeb.Common.ApiClient.INexoApiClient ApiClient

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">

            @* ── Cliente ─────────────────────────────────────── *@
            <ClienteAutocomplete Value="_clienteSeleccionado"
                                 ValueChanged="OnClienteSeleccionado"
                                 Label="Cliente*"
                                 Required="true"
                                 Class="mb-3" />

            <MudDatePicker @bind-Date="_validoHasta" Label="Válida hasta (opcional)" Class="mb-3" />
            <MudSelect T="int?" @bind-Value="_centroCostoId" Label="Centro de costo*"
                       Variant="Variant.Outlined" Class="mb-3" Required="true"
                       RequiredError="Selecciona un centro de costo.">
                @foreach (var cc in CentrosCosto)
                {
                    <MudSelectItem T="int?" Value="@((int?)cc.CentroCostoID)">@cc.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_notas" Label="Notas (opcional)" Lines="2" Class="mb-3" />

            <MudDivider Class="mb-3" />
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2">Artículos / Combos Cotizados</MudText>
                <div class="d-flex" style="gap:.4rem">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _lineas.Add(new LineaEditable()))">Agregar artículo</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.LocalOffer"
                               Color="Color.Secondary"
                               OnClick="@(() => _lineas.Add(new LineaEditable { EsCombo = true }))">Agregar combo</MudButton>
                </div>
            </div>

            @foreach (var linea in _lineas)
            {
                <div @key="linea" class="d-flex align-center mb-2" style="gap: 0.5rem;">
                    @if (linea.EsCombo)
                    {
                        <div @onclick="@(() => { if (linea.ComboSeleccionado?.TieneImagen == true) _imagenAmpliadaComboUri = linea.ComboSeleccionado.ImagenDataUri; })"
                             style="width:36px;min-width:36px;height:36px;border-radius:6px;overflow:hidden;background:var(--mud-palette-surface);border:1px solid var(--mud-palette-divider);display:flex;align-items:center;justify-content:center;cursor:@(linea.ComboSeleccionado?.TieneImagen == true ? "pointer" : "default");">
                            @if (linea.ComboSeleccionado?.TieneImagen == true)
                            {
                                <img src="@linea.ComboSeleccionado.ImagenDataUri" style="width:100%;height:100%;object-fit:cover;" alt="" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Color="Color.Secondary" />
                            }
                        </div>
                        <MudAutocomplete T="ComboItem?" Value="linea.ComboSeleccionado"
                                         ValueChanged="@((ComboItem? c) => OnComboCambiado(linea, c))"
                                         Label="Combo"
                                         SearchFunc="BuscarCombos"
                                         ToStringFunc="@(c => c?.Nombre ?? "")"
                                         Variant="Variant.Outlined" Style="flex: 3;"
                                         MinCharacters="0" ResetValueOnEmptyText="true" />
                    }
                    else
                    {
                        <div @onclick="@(() => _imagenAmpliada = (linea.ArticuloSeleccionado?.TieneImagen == true ? linea.ArticuloID : null))"
                             style="width:36px;min-width:36px;height:36px;border-radius:6px;overflow:hidden;background:var(--mud-palette-surface);border:1px solid var(--mud-palette-divider);display:flex;align-items:center;justify-content:center;cursor:@(linea.ArticuloSeleccionado?.TieneImagen == true ? "pointer" : "default");">
                            @if (linea.ArticuloSeleccionado?.TieneImagen == true)
                            {
                                <img src="api/catalogo/articulos/@linea.ArticuloID/imagen" style="width:100%;height:100%;object-fit:cover;" alt="" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" Style="color:var(--n-text-3)" />
                            }
                        </div>
                        <MudAutocomplete T="ArticuloItem?" Value="linea.ArticuloSeleccionado"
                                         ValueChanged="@((ArticuloItem? a) => OnArticuloCambiado(linea, a))"
                                         Label="Artículo"
                                         SearchFunc="BuscarArticulos"
                                         ToStringFunc="@(a => a is null ? "" : $"{a.Referencia} — {a.Nombre}")"
                                         Variant="Variant.Outlined" Style="flex: 3;"
                                         MinCharacters="0" ResetValueOnEmptyText="true" DebounceInterval="300" />
                    }
                    <MudNumericField T="decimal" @bind-Value="linea.Cantidad" Label="Cantidad" Style="flex: 1;" Min="0.01m" Format="N2" />
                    <MudNumericField T="decimal" @bind-Value="linea.PrecioUnitario" Label="Precio Unit." Style="flex: 1;" Min="0m" Format="N0" />
                    <MudText Typo="Typo.body2" Style="flex: 1; text-align: right;">@((linea.Cantidad * linea.PrecioUnitario).ToString("C0"))</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _lineas.Remove(linea))" />
                </div>
            }

            <MudText Typo="Typo.subtitle1" Class="d-block mt-2" Style="text-align: right;">
                Total: @_lineas.Where(l => l.Cantidad > 0).Sum(l => l.Cantidad * l.PrecioUnitario).ToString("C0")
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            Crear Cotización
        </MudButton>
    </DialogActions>
</MudDialog>

@if (_imagenAmpliada.HasValue)
{
    <div @onclick="@(() => _imagenAmpliada = null)"
         style="position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <img src="api/catalogo/articulos/@_imagenAmpliada/imagen"
             style="max-width:80vw;max-height:80vh;border-radius:12px;box-shadow:0 8px 40px rgba(0,0,0,0.6);" alt="" />
    </div>
}

@if (_imagenAmpliadaComboUri is not null)
{
    <div @onclick="@(() => _imagenAmpliadaComboUri = null)"
         style="position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <img src="@_imagenAmpliadaComboUri"
             style="max-width:80vw;max-height:80vh;border-radius:12px;box-shadow:0 8px 40px rgba(0,0,0,0.6);" alt="" />
    </div>
}

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<CentroCostoItem> CentrosCosto { get; set; } = new();

    private class LineaEditable
    {
        public bool          EsCombo             { get; set; }
        public ArticuloItem? ArticuloSeleccionado { get; set; }
        public int?          ArticuloID           { get; set; }
        public ComboItem?    ComboSeleccionado    { get; set; }
        public int?          ComboID              { get; set; }
        public decimal       Cantidad             { get; set; } = 1;
        public decimal       PrecioUnitario       { get; set; }
    }

    private MudForm      _form   = default!;
    private ClienteItem? _clienteSeleccionado;
    private List<ComboItem> _combosActivos = new();
    private int? _imagenAmpliada;
    private string? _imagenAmpliadaComboUri;

    private DateTime? _fecha      = NexoWeb.Common.ColombiaClock.Today;
    private DateTime? _validoHasta;
    private string?   _notas;
    private int?      _centroCostoId;
    private List<LineaEditable> _lineas = new() { new LineaEditable() };

    protected override async Task OnInitializedAsync()
    {
        _combosActivos = await ApiClient.GetAsync<List<ComboItem>>("api/marketing/combos?estado=Activo") ?? new();
        if (CentrosCosto.Count == 1)
            _centroCostoId = CentrosCosto[0].CentroCostoID;
    }

    private void OnClienteSeleccionado(ClienteItem? cliente)
    {
        _clienteSeleccionado = cliente;
    }

    private void OnArticuloCambiado(LineaEditable linea, ArticuloItem? articulo)
    {
        linea.ArticuloSeleccionado = articulo;
        linea.ArticuloID           = articulo?.ArticuloID;
        if (articulo is not null)
            linea.PrecioUnitario = articulo.PrecioVenta;
    }

    private void OnComboCambiado(LineaEditable linea, ComboItem? combo)
    {
        linea.ComboSeleccionado = combo;
        linea.ComboID           = combo?.ComboID;
        if (combo is not null)
            linea.PrecioUnitario = combo.PrecioEfectivo;
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _clienteSeleccionado is null || _centroCostoId is null)
        {
            if (_centroCostoId is null)
                Snackbar.Add("Selecciona un centro de costo.", Severity.Warning);
            return;
        }

        var lineasValidas = _lineas
            .Where(l => l.Cantidad > 0 && (l.ArticuloID.HasValue || l.ComboID.HasValue))
            .Select(l => new LineaCotizacionInput(l.ArticuloID, l.Cantidad, l.PrecioUnitario, l.ComboID))
            .ToList();

        if (lineasValidas.Count == 0)
        {
            Snackbar.Add("Agrega al menos un artículo o combo con cantidad mayor a cero.", Severity.Warning);
            return;
        }

        var request = new CrearCotizacionRequest(_clienteSeleccionado.ClienteID, null, _fecha.Value, _validoHasta, _notas, lineasValidas, _centroCostoId);
        MudDialog.Close(DialogResult.Ok(request));
    }

    private Task<IEnumerable<ArticuloItem>> BuscarArticulos(string? texto, CancellationToken ct)
        => ApiClient.BuscarArticulosAsync(texto, ct);

    private Task<IEnumerable<ComboItem>> BuscarCombos(string? texto, CancellationToken ct)
    {
        var resultado = string.IsNullOrWhiteSpace(texto)
            ? _combosActivos
            : _combosActivos.Where(c => c.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ComboItem>>(resultado);
    }

    private void Cancelar() => MudDialog.Cancel();
}
