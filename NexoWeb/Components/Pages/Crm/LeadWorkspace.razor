    private async Task CambiarEtapaOportunidadAsync(OportunidadItem op, string nuevaEtapa)
    {
        try
        {
            var req = new ActualizarOportunidadRequest(
                op.Nombre, op.ValorEstimado, op.ConfianzaCierre,
                nuevaEtapa, op.FechaCierreEsperada, op.ResponsableID, op.Notas);
            await ApiClient.PutAsync<ActualizarOportunidadRequest>($"api/crm/oportunidades/{op.OportunidadID}", req);
            Snackbar.Add($"Oportunidad → {nuevaEtapa}", Severity.Success);
            await CargarOportunidadesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }
