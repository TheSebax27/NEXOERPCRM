    // ── Bloques ───────────────────────────────────────────────────────────────

    void AgregarBloque(string tipo)
    {
        var obj = new JsonObject { ["tipo"] = tipo };
        switch (tipo)
        {
            case "titulo":   obj["texto"] = "Escribe tu título aquí"; break;
            case "parrafo":  obj["texto"] = "Hola {{nombre}}, te escribimos para informarte..."; break;
            case "imagen":   obj["src"] = ""; obj["alt"] = ""; break;
            case "boton":    obj["texto"] = "Ver más"; obj["url"] = "https://"; break;
        }
        _bloques.Add(obj);
    }

    void EliminarBloque(int idx) { _bloques.RemoveAt(idx); }

    void MoverBloque(int idx, int dir)
    {
        var dest = idx + dir;
        if (dest < 0 || dest >= _bloques.Count) return;
        (_bloques[idx], _bloques[dest]) = (_bloques[dest], _bloques[idx]);
    }

    static string EtiquetaTipo(string tipo) => tipo switch
    {
        "titulo"    => "Título",
        "parrafo"   => "Párrafo",
        "imagen"    => "Imagen",
        "boton"     => "Botón",
        "separador" => "Separador",
        _           => tipo
    };

    // ── Galería de imágenes ───────────────────────────────────────────────────

    async Task CargarImagenes()
    {
        _cargandoImagenes = true;
        StateHasChanged();
        var lista = await Api.GetAsync<List<ImagenItem>>("api/marketing/imagenes") ?? [];
        _imagenes = [];
        foreach (var img in lista)
        {
            var src = await ObtenerSrcImagenAsync(img.ImagenID, img.ContentType);
            _imagenes.Add(new ImagenVm(img.ImagenID, img.Nombre, src));
        }
        _cargandoImagenes = false;
        StateHasChanged();
    }

    async Task<string> ObtenerSrcImagenAsync(int id, string contentType)
    {
        try
        {
            var res = await Api.GetAsync<JsonObject>($"api/marketing/imagenes/{id}");
            if (res is null) return "";
            var b64 = res["base64"]?.GetValue<string>() ?? "";
            var ct  = res["contentType"]?.GetValue<string>() ?? contentType;
            return $"data:{ct};base64,{b64}";
        }
        catch { return ""; }
    }

    // Abre el modal de galería apuntando al bloque idx
    async Task AbrirModalGaleria(int idx)
    {
        _bloqueImagenActivo = idx;
        _mostrarGaleria = true;
        // Si aún no hay imágenes cargadas las cargamos al abrir el modal
        if (_imagenes.Count == 0)
            await CargarImagenes();
    }

    // Llamado cuando el usuario hace clic en una imagen dentro del modal
    void InsertarImagenDesdeModal(ImagenVm img)
    {
        if (_bloqueImagenActivo >= 0 && _bloqueImagenActivo < _bloques.Count)
            _bloques[_bloqueImagenActivo]["src"] = img.Src;
        _mostrarGaleria = false;
        _bloqueImagenActivo = -1;
    }

    async Task SubirImagen(IBrowserFile file)
    {
        if (file.Size > 5 * 1024 * 1024)
        {
            Snack.Add("La imagen no puede superar 5 MB.", Severity.Warning);
            return;
        }
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var req = new SubirImagenRequest(file.Name, file.ContentType, b64);
            await Api.PostAsync<SubirImagenRequest>("api/marketing/imagenes", req);
            Snack.Add("Imagen subida.", Severity.Success);
            await CargarImagenes();
        }
        catch (Exception ex) { Snack.Add($"No se pudo subir: {ex.Message}", Severity.Error); }
    }

    // Sube imagen desde dentro del modal de galería y recarga la lista
    async Task SubirImagenYRecargar(IBrowserFile file)
    {
        await SubirImagen(file);
    }

    async Task EliminarImagen(int id)
    {
        try { await Api.DeleteAsync($"api/marketing/imagenes/{id}"); }
        catch { /* continuar */ }
        _imagenes.RemoveAll(i => i.ImagenID == id);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    static List<JsonObject> ParseBloques(string json)
    {
        try
        {
            var arr = JsonNode.Parse(json)?.AsArray();
            return arr?.Select(n => n?.AsObject() ?? new JsonObject()).ToList() ?? [];
        }
        catch { return []; }
    }

    public void Dispose()
    {
        _timerContador?.Stop();
        _timerContador?.Dispose();
    }
}
