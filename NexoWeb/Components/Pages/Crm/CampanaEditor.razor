        var res = await Api.PostAsync<object, JsonObject>("api/marketing/campanas/preview",
            new { BloqueJSON = JsonSerializer.Serialize(_bloques), NombreCliente = "Juan Ejemplo" });
        _htmlPreview  = res?["html"]?.GetValue<string>() ?? "";
        _mostrarPreview = true;
    }

