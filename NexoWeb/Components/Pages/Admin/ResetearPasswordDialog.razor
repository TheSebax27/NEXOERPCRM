@using NexoWeb.Common.Dtos
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        @if (!_mostrandoClave)
        {
            <MudForm @ref="_form" Model="@this">
                <MudTextField @bind-Value="_nuevaPassword" Label="Nueva Contrasena" InputType="InputType.Password"
                              Required="true" RequiredError="La contrasena es obligatoria"
                              MinLength="6" Validation="@(new Func<string, string?>(ValidarLongitud))" Class="mb-3" />

                <MudTextField @bind-Value="_confirmar" Label="Confirmar Contrasena" InputType="InputType.Password"
                              Required="true" RequiredError="Confirma la contrasena"
                              Validation="@(new Func<string, string?>(ValidarCoincide))" Class="mb-3" />
            </MudForm>
        }
        else
        {
            <div class="d-flex flex-column align-center" style="gap:12px; padding:8px 0">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:2.5rem" />
                <MudText Typo="Typo.subtitle1">Contraseña actualizada</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Copia y comparte con el usuario</MudText>
                <div class="d-flex align-center" style="gap:8px; background:var(--mud-palette-background-grey); padding:10px 16px; border-radius:8px; width:100%">
                    <MudText Style="flex:1; font-size:1.1rem; font-weight:600; letter-spacing:.05em">@_nuevaPassword</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   OnClick="CopiarAsync" Title="Copiar" />
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (!_mostrandoClave)
        {
            <MudButton OnClick="Cancelar">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
                Guardar
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Cerrar">
                Listo
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private string _nuevaPassword = string.Empty;
    private string _confirmar = string.Empty;
    private bool _mostrandoClave;

    private string? ValidarLongitud(string valor)
        => string.IsNullOrEmpty(valor) || valor.Length >= 6 ? null : "Minimo 6 caracteres";

    private string? ValidarCoincide(string valor)
        => valor == _nuevaPassword ? null : "Las contraseñas no coinciden";

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        _mostrandoClave = true;
    }

    private void Cerrar()
    {
        var request = new ResetearPasswordRequest(_nuevaPassword);
        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task CopiarAsync()
        => await JS.InvokeVoidAsync("navigator.clipboard.writeText", _nuevaPassword);
}
