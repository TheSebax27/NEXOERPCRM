    private (Color Color, string Texto) EstadoAgente(EstadoIntegracionResponse ag)
    {
        if (!ag.Activo) return (Color.Default, "Desactivado");
        if (ag.SyncPausada) return (Color.Warning, "Pausado");
        if (!ag.UltimoLatido.HasValue) return (Color.Warning, "Sin conexión");
        var hace = DateTime.UtcNow - ag.UltimoLatido.Value;
        if (hace.TotalMinutes >= 30) return (Color.Error, "Sin respuesta");
        if (hace.TotalMinutes >= 10) return (Color.Warning, "Alerta");
        if (ag.EventosConError > 0) return (Color.Warning, "Con errores");
        return (Color.Success, "Conectado");
    }

    private string MotivoAlerta(EstadoIntegracionResponse ag)
    {
        if (!ag.Activo)
            return "El agente está marcado como inactivo en la configuración. Actívalo desde Configurar Agente.";
        if (ag.SyncPausada)
            return "La sincronización fue pausada manualmente. El servicio sigue corriendo pero no procesa ni envía eventos. Usa el botón ▶ para reanudar.";
        if (!ag.UltimoLatido.HasValue)
            return "El agente nunca ha enviado un latido. Verifica que el servicio NexoSyncAgent esté instalado y corriendo en el servidor de Visions.";

        var motivos = new System.Text.StringBuilder();
        var hace = DateTime.UtcNow - ag.UltimoLatido.Value;
        var horaLocal = ag.UltimoLatido.Value.ToLocalTime().ToString("HH:mm:ss");

        if (hace.TotalMinutes >= 30)
            motivos.AppendLine($"⚠ Sin latido hace {(int)hace.TotalHours}h {hace.Minutes}min (último a las {horaLocal}). El servicio NexoSyncAgent probablemente se detuvo — reinícialo en el servidor de Visions.");
        else if (hace.TotalMinutes >= 10)
            motivos.AppendLine($"⚠ Sin latido hace {(int)hace.TotalMinutes} min (último a las {horaLocal}). El agente puede estar colgado — si sigue activo en el servidor, reinícialo.");

        if (ag.EventosConError > 0)
            motivos.AppendLine($"⚠ {ag.EventosConError} evento(s) saliente(s) con error. Usa el botón Reintentar (↺) para volver a intentarlos.");

        if (ag.ArticulosFaltantesVisions > 0)
            motivos.AppendLine($"ℹ {ag.ArticulosFaltantesVisions} artículo(s) de otros centros Visions no están en este. Usa \"Sí, Sincronizar\" para agregarlos.");

        var texto = motivos.ToString().Trim();
        return texto.Length > 0 ? texto : "El agente funciona correctamente.";
    }

    private async Task MostrarMotivoAsync(EstadoIntegracionResponse ag)
    {
        var estado = EstadoAgente(ag);
        await DialogService.ShowMessageBox(
