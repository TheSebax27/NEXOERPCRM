    private async Task ToggleSyncPausadaAsync(int agenteSyncId, bool estabaActivo)
    {
        _pausando.Add(agenteSyncId);
        try
        {
            var nuevaPausa = !estabaActivo;
            await ApiClient.PutAsync($"api/integracion/agentes/{agenteSyncId}/sync-pausada", nuevaPausa);
            var agente = _agentes.FirstOrDefault(a => a.AgenteSyncID == agenteSyncId);
            if (agente is not null)
            {
                _agentes = _agentes.Select(a => a.AgenteSyncID == agenteSyncId
                    ? a with { SyncPausada = nuevaPausa }
                    : a).ToList();
            }
            Snackbar.Add(nuevaPausa ? "Sincronización pausada." : "Sincronización reanudada.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _pausando.Remove(agenteSyncId);
        }
    }

