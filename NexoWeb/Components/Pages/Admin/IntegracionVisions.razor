    private async Task SolicitarReprocesoAsync(int agenteSyncId, int centroCostoId, string etiqueta, string tipo)
    {
        var confirmado = await DialogService.ShowMessageBox(
            $"Reprocesar {etiqueta}",
            $"El agente volverá a leer todos los {etiqueta.ToLower()} desde Visions y actualizará NEXO. " +
            $"No se elimina ni toca inventario, recetas ni usuarios. " +
            $"El proceso puede tardar varios ciclos del agente (lotes de 500 por vez). ¿Continuar?",
            yesText: $"Sí, reprocesar {etiqueta.ToLower()}", cancelText: "Cancelar");
        if (confirmado != true) return;

        try
        {
            await ApiClient.PostAsync($"api/integracion/agentes/{agenteSyncId}/reprocesar",
                new { tipo });
            _reprocesoActivo[agenteSyncId] = true;
            _tipoReprocesoSolicitado[agenteSyncId] = tipo;
            _progresoReproceso[agenteSyncId] = new EstadoReprocesoDto(tipo, "EnProceso", null, 0, NexoWeb.Common.ColombiaClock.Now, null, null);
            IniciarPollingReproceso(agenteSyncId);
            Snackbar.Add($"Reproceso de {etiqueta.ToLower()} solicitado. Esperando agente...", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void IniciarPollingReproceso(int agenteSyncId)
    {
        _reprocesoPollingCts.Cancel();
        _reprocesoPollingCts.Dispose();
        _reprocesoPollingCts = new CancellationTokenSource();
        var ct = _reprocesoPollingCts.Token;

        _timerReproceso?.Dispose();
        _timerReproceso = new System.Timers.Timer(2500);
        _timerReproceso.Elapsed += async (_, _) =>
        {
            if (ct.IsCancellationRequested) return;
            try
            {
                var estado = await ApiClient.GetAsync<EstadoReprocesoDto?>($"api/integracion/agentes/{agenteSyncId}/estado-reproceso");
                if (ct.IsCancellationRequested) return;
                await InvokeAsync(() =>
                {
                    _progresoReproceso[agenteSyncId] = estado;
                    if (estado?.Estado is "Completado" or "Error")
                    {
                        _reprocesoActivo[agenteSyncId] = false;
                        _timerReproceso?.Stop();
                    }
                    StateHasChanged();
                });
            }
            catch { /* silencioso: no interrumpir UI por fallo de polling */ }
        };
        _timerReproceso.AutoReset = true;
        _timerReproceso.Start();
    }

    private record SincAntsaResponse(bool Activo);
    private record SincAntsaRequest(bool Activo);
    private record ReintentarPendientesResponse(string Mensaje, int Count);
    private record EstadoReprocesoDto(string TipoReproceso, string Estado, int? TotalEstimado, int Procesados, DateTime? FechaInicio, DateTime? FechaFin, string? Mensaje);

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _reprocesoPollingCts.Cancel();
        _reprocesoPollingCts.Dispose();
        _timerReproceso?.Stop();
        _timerReproceso?.Dispose();
    }
