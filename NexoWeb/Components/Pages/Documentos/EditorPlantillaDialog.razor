@using NexoWeb.Common.Dtos
@using System.IO
@using System.Linq
@using System.Text
@implements IAsyncDisposable
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Style="min-width: 940px; max-width: 1120px;">
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_nombre" Label="Nombre de la plantilla"
                                  Required="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_tipoEntidad" Label="Aplica a"
                               Variant="Variant.Outlined" Required="true">
                        <MudSelectItem T="string" Value="@("GENERAL")">General</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CLIENTE")">Clientes</MudSelectItem>
                        <MudSelectItem T="string" Value="@("PROVEEDOR")">Proveedores</MudSelectItem>
                        <MudSelectItem T="string" Value="@("EMPLEADO")">Empleados</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_descripcion" Label="Descripción (opcional)"
                                  Lines="2" Variant="Variant.Outlined" />
                </MudItem>

                @* ── Variable picker ───────────────────────────────────────── *@
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="d-block mb-1" Style="color:var(--n-text-3)">
                        Variables disponibles — clic para insertar en el cursor:
                    </MudText>
                    <div class="d-flex flex-wrap" style="gap:6px;margin-bottom:8px">
                        @foreach (var grupo in VariablesDisponibles)
                        {
                            @foreach (var v in grupo.Variables)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@grupo.Color"
                                         OnClick="@(() => InsertarVariableAsync(v.Clave))"
                                         Style="cursor:pointer;font-family:monospace;font-size:0.75rem">
                                    @("{{" + v.Clave + "}}")
                                </MudChip>
                            }
                        }
                    </div>
                </MudItem>

                @* ── Editor Quill ──────────────────────────────────────────── *@
                <MudItem xs="12">
                    <div class="nexo-quill-wrapper">
                        <div id="@_editorId"></div>
                    </div>
                </MudItem>

                @if (EsEdicion)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_activa" Label="Plantilla activa" Color="Color.Primary" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <InputFile id="@_importInputId" OnChange="OnArchivoSeleccionadoAsync"
                   accept=".pdf,.docx" style="display:none" />
        <label for="@_importInputId">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="_importando" Style="pointer-events:none">
                @(_importando ? "Importando..." : "Importar Word/PDF")
            </MudButton>
        </label>
        <MudSpacer />
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync" Disabled="_guardando">
            @(_guardando ? "Guardando..." : EsEdicion ? "Guardar cambios" : "Crear plantilla")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PlantillaDetalle? Plantilla { get; set; }

    private bool EsEdicion => Plantilla is not null;

    private MudForm _form = default!;
    private string _nombre = string.Empty;
    private string? _descripcion;
    private string _tipoEntidad = "GENERAL";
    private string _cuerpo = string.Empty;
    private bool _activa = true;
    private bool _guardando;
    private bool _importando;
    private bool _editorInicializado;
    private string _editorId = $"quill-{Guid.NewGuid():N}";
    private string _importInputId = $"import-{Guid.NewGuid():N}";

    // ── Variables predefinidas agrupadas ──────────────────────────────────
    private record VarDef(string Clave, string Label);
    private record VarGrupo(string Titulo, Color Color, IEnumerable<VarDef> Variables);

    private string _tipoEntidadCacheado = "";
    private VarGrupo[]? _variablesCache;

    private IEnumerable<VarGrupo> VariablesDisponibles
    {
        get
        {
            if (_variablesCache is null || _tipoEntidadCacheado != _tipoEntidad)
            {
                _tipoEntidadCacheado = _tipoEntidad;
                _variablesCache = BuildVariablesDisponibles();
            }
            return _variablesCache;
        }
    }

    private VarGrupo[] BuildVariablesDisponibles() => new[]
    {
        new VarGrupo("General", Color.Default, new VarDef[]
        {
            new("fecha_actual",  "Fecha actual"),
            new("fecha_inicio",  "Fecha inicio"),
            new("fecha_fin",     "Fecha fin"),
            new("valor",         "Valor"),
            new("descripcion",   "Descripción"),
            new("ciudad",        "Ciudad"),
            new("pais",          "País"),
        }),
        new VarGrupo("Empresa", Color.Dark, new VarDef[]
        {
            new("nombre_empresa",      "Empresa"),
            new("nit_empresa",         "NIT empresa"),
            new("representante_legal", "Rep. legal"),
        }),
        new VarGrupo("Cliente", Color.Primary, _tipoEntidad is "GENERAL" or "CLIENTE"
            ? new VarDef[]
            {
                new("nombre_cliente",    "Nombre"),
                new("nit_cliente",       "NIT"),
                new("email_cliente",     "Email"),
                new("telefono_cliente",  "Teléfono"),
                new("direccion_cliente", "Dirección"),
            }
            : Array.Empty<VarDef>()),
        new VarGrupo("Proveedor", Color.Secondary, _tipoEntidad is "GENERAL" or "PROVEEDOR"
            ? new VarDef[]
            {
                new("nombre_proveedor",   "Nombre"),
                new("nit_proveedor",      "NIT"),
                new("email_proveedor",    "Email"),
                new("telefono_proveedor", "Teléfono"),
            }
            : Array.Empty<VarDef>()),
        new VarGrupo("Empleado", Color.Tertiary, _tipoEntidad is "GENERAL" or "EMPLEADO"
            ? new VarDef[]
            {
                new("nombre_empleado", "Nombre"),
                new("cargo_empleado",  "Cargo"),
                new("salario_empleado","Salario"),
            }
            : Array.Empty<VarDef>()),
    }.Where(g => g.Variables.Any()).ToArray();

    protected override void OnInitialized()
    {
        if (Plantilla is not null)
        {
            _nombre      = Plantilla.Nombre;
            _descripcion = Plantilla.Descripcion;
            _tipoEntidad = Plantilla.TipoEntidad;
            _cuerpo      = Plantilla.Cuerpo;
            _activa      = Plantilla.Activa;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_editorInicializado)
        {
            _editorInicializado = true;
            try
            {
                await JS.InvokeVoidAsync("quillInterop.init", _editorId, false, ConvertirAHtml(_cuerpo));
            }
            catch
            {
                // Retry once after brief delay (element may not be in DOM yet on first render)
                await Task.Delay(150);
                try { await JS.InvokeVoidAsync("quillInterop.init", _editorId, false, ConvertirAHtml(_cuerpo)); }
                catch { /* Editor no disponible */ }
            }
        }
    }

    private async Task InsertarVariableAsync(string clave)
    {
        var texto = "{{" + clave + "}}";
        try { await JS.InvokeVoidAsync("quillInterop.insertText", _editorId, texto); }
        catch { /* no hacer nada si el editor no está listo */ }
    }

    private async Task OnArchivoSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (ext is not ".pdf" and not ".docx")
        {
            Snackbar.Add("Solo se aceptan archivos .pdf o .docx.", Severity.Warning);
            return;
        }
        const long maxBytes = 10 * 1024 * 1024;
        if (archivo.Size > maxBytes)
        {
            Snackbar.Add("El archivo supera el límite de 10 MB.", Severity.Warning);
            return;
        }

        _importando = true;
        StateHasChanged();
        try
        {
            using var ms = new MemoryStream();
            await archivo.OpenReadStream(maxBytes).CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var req = new ImportarArchivoRequest(base64, archivo.Name);
            var result = await ApiClient.PostAsync<ImportarArchivoRequest, ImportarPlantillaResult>(
                "api/documentos/plantillas/importar", req);

            if (result is not null)
            {
                var html = ConvertirAHtml(result.Cuerpo);
                await JS.InvokeVoidAsync("quillInterop.setHtml", _editorId, html);

                if (result.Variables.Count > 0)
                    Snackbar.Add($"Importado. {result.Variables.Count} variable(s) detectada(s): " +
                        string.Join(", ", result.Variables.Select(v => "{{" + v + "}}")),
                        Severity.Info, cfg => cfg.VisibleStateDuration = 6000);
                else
                    Snackbar.Add("Archivo importado correctamente.", Severity.Success);
            }
        }
        catch { Snackbar.Add("No se pudo importar el archivo.", Severity.Error); }
        finally { _importando = false; StateHasChanged(); }
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _guardando = true;
        try
        {
            string htmlContent = _cuerpo;
            if (_editorInicializado)
            {
                try { htmlContent = await JS.InvokeAsync<string>("quillInterop.getHtml", _editorId); }
                catch { htmlContent = _cuerpo; }
            }

            var variables = ExtraerVariables(htmlContent);

            if (EsEdicion)
            {
                var req = new ActualizarPlantillaRequest(_nombre, _descripcion, _tipoEntidad, htmlContent, variables, _activa);
                await ApiClient.PutAsync<ActualizarPlantillaRequest, object?>(
                    $"api/documentos/plantillas/{Plantilla!.PlantillaID}", req);
                Snackbar.Add("Plantilla actualizada.", Severity.Success);
            }
            else
            {
                var req = new CrearPlantillaRequest(_nombre, _descripcion, _tipoEntidad, htmlContent, variables);
                await ApiClient.PostAsync<CrearPlantillaRequest, object?>("api/documentos/plantillas", req);
                Snackbar.Add("Plantilla creada.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch { Snackbar.Add("Error al guardar la plantilla.", Severity.Error); }
        finally { _guardando = false; }
    }

    private static string ConvertirAHtml(string texto)
    {
        if (string.IsNullOrEmpty(texto)) return "";
        var trimmed = texto.TrimStart();
        // Already HTML?
        if (trimmed.StartsWith("<p") || trimmed.StartsWith("<h") ||
            trimmed.StartsWith("<ul") || trimmed.StartsWith("<ol") ||
            trimmed.StartsWith("<div"))
            return texto;
        // Plain text → paragraphs
        var sb = new StringBuilder();
        foreach (var raw in texto.Split('\n'))
        {
            var line = raw.TrimEnd('\r');
            sb.Append(string.IsNullOrWhiteSpace(line)
                ? "<p><br></p>"
                : $"<p>{System.Net.WebUtility.HtmlEncode(line)}</p>");
        }
        return sb.ToString();
    }

    private static string? ExtraerVariables(string cuerpo)
    {
        var matches = System.Text.RegularExpressions.Regex
            .Matches(cuerpo, @"\{\{(\w+)\}\}")
            .Select(m => m.Groups[1].Value)
            .Distinct()
            .ToList();
        return matches.Count == 0 ? null : System.Text.Json.JsonSerializer.Serialize(matches);
    }

    private void Cancelar() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("quillInterop.destroy", _editorId); } catch { }
    }
}
