@using NexoWeb.Common.Dtos
@implements IAsyncDisposable
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Style="min-width: 520px;">
    <DialogContent>
        <MudTextField @bind-Value="_firmaNombre" Label="Nombre del firmante"
                      Variant="Variant.Outlined" Class="mb-3" Required="true" />

        <MudTabs @bind-ActivePanelIndex="_tabActivo" Elevation="0" Rounded="true" PanelClass="pt-2">

            <MudTabPanel Text="Dibujar">
                <MudText Typo="Typo.caption" Class="d-block mb-1" Style="color: var(--n-text-3);">
                    Dibuja tu firma en el recuadro:
                </MudText>
                <div style="border: 2px dashed #6C5CE7; border-radius: 8px; overflow: hidden; background: #fff;">
                    <canvas id="@_canvasId"
                            style="width: 100%; height: 160px; display: block; cursor: crosshair;" />
                </div>
                <div class="d-flex justify-end mt-1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LimpiarAsync">Limpiar</MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Subir imagen">
                <InputFile id="@_fileInputId" OnChange="CargarImagenAsync"
                           accept="image/png,image/jpeg,image/gif,image/webp"
                           style="display:none;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-2"
                           OnClick="ClickFileInputAsync">
                    Elegir imagen de firma
                </MudButton>

                @if (_imagenCargada)
                {
                    <div style="border: 2px dashed #6C5CE7; border-radius: 8px; overflow: hidden; background: #fff;">
                        <canvas id="@_imageCanvasId"
                                style="width: 100%; height: 160px; display: block;" />
                    </div>
                    <div class="mt-3">
                        <MudText Typo="Typo.caption" Class="mb-0">
                            Tamaño: @($"{(int)(_escala * 100)}%")
                        </MudText>
                        <MudSlider T="double"
                                   Value="_escala"
                                   ValueChanged="@(async (double v) => { _escala = v; await ActualizarImagenAsync(); })"
                                   Min="0.2" Max="2.0" Step="0.05" Class="mb-1" />
                        <MudText Typo="Typo.caption" Class="mt-1 mb-0">
                            Quitar fondo blanco: @(_umbral == 0 ? "desactivado" : $"umbral {_umbral}")
                        </MudText>
                        <MudSlider T="int"
                                   Value="_umbral"
                                   ValueChanged="@(async (int v) => { _umbral = v; await ActualizarImagenAsync(); })"
                                   Min="0" Max="254" Step="2" />
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.caption" Style="color: var(--n-text-3);">
                        Sube una foto o imagen de tu firma manuscrita. Podrás ajustar el tamaño y quitar el fondo.
                    </MudText>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="GuardarAsync" Disabled="_guardando">
            @(_guardando ? "Guardando..." : "Guardar firma")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int DocumentoID { get; set; }

    private readonly string _canvasId      = $"firma-canvas-{Guid.NewGuid():N}";
    private readonly string _imageCanvasId = $"firma-img-{Guid.NewGuid():N}";
    private readonly string _fileInputId   = $"firma-file-{Guid.NewGuid():N}";

    private string _firmaNombre = string.Empty;
    private int    _tabActivo;
    private bool   _guardando;

    private bool   _imagenCargada;
    private double _escala = 1.0;
    private int    _umbral = 200;
    private string? _pendingImageUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await InicializarCanvasAsync();

        if (_pendingImageUrl is { } url)
        {
            _pendingImageUrl = null;
            try
            {
                await JS.InvokeVoidAsync("signaturePadInterop.initImageCanvas", _imageCanvasId);
                await JS.InvokeVoidAsync("signaturePadInterop.loadImage", _imageCanvasId, url, _escala, _umbral);
            }
            catch { }
        }
    }

    private async Task InicializarCanvasAsync()
    {
        try { await JS.InvokeVoidAsync("signaturePadInterop.init", _canvasId); } catch { }
    }

    private async Task ClickFileInputAsync()
    {
        try { await JS.InvokeVoidAsync("signaturePadInterop.clickElement", _fileInputId); } catch { }
    }

    private async Task CargarImagenAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 5_000_000)
        {
            Snackbar.Add("Imagen demasiado grande (máx 5 MB).", Severity.Warning);
            return;
        }
        try
        {
            using var stream = file.OpenReadStream(5_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _imagenCargada = true;
            _pendingImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch
        {
            Snackbar.Add("No se pudo leer la imagen.", Severity.Error);
        }
    }

    private async Task ActualizarImagenAsync()
    {
        try { await JS.InvokeVoidAsync("signaturePadInterop.redrawImage", _imageCanvasId, _escala, _umbral); }
        catch { }
    }

    private async Task LimpiarAsync()
    {
        try { await JS.InvokeVoidAsync("signaturePadInterop.clear", _canvasId); } catch { }
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_firmaNombre)) return;

        string? firmaBase64 = null;
        try
        {
            firmaBase64 = _tabActivo == 0
                ? await JS.InvokeAsync<string?>("signaturePadInterop.toDataURL", _canvasId)
                : await JS.InvokeAsync<string?>("signaturePadInterop.getImageDataUrl", _imageCanvasId);
        }
        catch { }

        if (string.IsNullOrEmpty(firmaBase64))
        {
            Snackbar.Add(_tabActivo == 0
                ? "Dibuja tu firma antes de guardar."
                : "Carga una imagen de firma primero.",
                Severity.Warning);
            return;
        }

        _guardando = true;
        try
        {
            await ApiClient.PostAsync<AgregarFirmaRequest, object?>(
                $"api/documentos/{DocumentoID}/firma",
                new AgregarFirmaRequest(firmaBase64, _firmaNombre));
            Snackbar.Add("Firma guardada.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch { Snackbar.Add("Error al guardar la firma.", Severity.Error); }
        finally { _guardando = false; }
    }

    private void Cancelar() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("signaturePadInterop.destroy", _canvasId); } catch { }
        try { await JS.InvokeVoidAsync("signaturePadInterop.destroyImage", _imageCanvasId); } catch { }
    }
}
