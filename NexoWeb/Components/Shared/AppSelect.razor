@* Combobox NEXO: el trigger es un input, escribir filtra en tiempo real.
   <AppSelect TValue="int?" Label="Usuario" Placeholder="Selecciona..."
              Items="@items" Value="_id" ValueChanged="OnCambio"
              Style="max-width:420px" Class="mb-4" /> *@
@typeparam TValue
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="app-select-wrap @Class" style="@Style" @ref="_wrapRef">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="app-select-lbl">@Label</label>
    }

    <div class="app-sel-combo @(_open ? "app-sel--open" : "") @(Disabled ? "app-sel--disabled" : "")">
        <input class="app-sel-combo-input"
               type="text"
               placeholder="@(Placeholder ?? "Selecciona...")"
               value="@(_open ? _search : CurrentLabel ?? "")"
               @oninput="OnInput"
               @onfocus="Open"
               disabled="@Disabled"
               autocomplete="off"
               spellcheck="false" />
        <span class="app-sel-arrow" @onclick="ToggleArrow" @onclick:stopPropagation="true">▾</span>
    </div>

    @if (_open)
    {
        <div class="app-sel-backdrop" @onclick="Close"></div>
    }
    @* List always rendered — JS teleports it to document.body when open to escape dialog transform context *@
    <div class="app-sel-list" @ref="_listRef">
        @if (!string.IsNullOrEmpty(Placeholder))
        {
            <div class="app-sel-item app-sel-item--ph" @onclick="() => Pick(default)">
                @Placeholder
            </div>
        }
        @foreach (var item in FilteredItems)
        {
            bool sel = EqualityComparer<TValue?>.Default.Equals(item.ItemValue, Value);
            <div class="app-sel-item @(sel ? "app-sel-item--active" : "")"
                 @onclick="() => Pick(item.ItemValue)">
                @item.Label
            </div>
        }
        @if (!FilteredItems.Any())
        {
            <div class="app-sel-item app-sel-item--ph" style="pointer-events:none">Sin resultados</div>
        }
    </div>
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<AppSelectItem<TValue>> Items { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _wrapRef;
    private ElementReference _listRef;
    private bool _open;
    private bool _positionPending;
    private bool _returnPending;
    private string _search = "";

    private string? CurrentLabel =>
        Items.FirstOrDefault(i => EqualityComparer<TValue?>.Default.Equals(i.ItemValue, Value))?.Label;

    private IEnumerable<AppSelectItem<TValue>> FilteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? Items
            : Items.Where(i => i.Label.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _positionPending)
        {
            _positionPending = false;
            try { await JS.InvokeVoidAsync("nexoAppSelect.positionList", _wrapRef, _listRef); }
            catch { }
        }
        else if (!_open && _returnPending)
        {
            _returnPending = false;
            try { await JS.InvokeVoidAsync("nexoAppSelect.returnList", _wrapRef, _listRef); }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("nexoAppSelect.returnList", _wrapRef, _listRef); }
        catch { }
    }

    private void Open()
    {
        if (Disabled) return;
        _search = "";
        _open = true;
        _positionPending = true;
    }

    private void Close()
    {
        _search = "";
        _open = false;
        _returnPending = true;
    }

    private void ToggleArrow()
    {
        if (Disabled) return;
        if (_open) Close();
        else Open();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _open = true;
        _positionPending = true;
    }

    private async Task Pick(TValue? val)
    {
        _search = "";
        _open = false;
        _returnPending = true;
        await ValueChanged.InvokeAsync(val);
    }
}
