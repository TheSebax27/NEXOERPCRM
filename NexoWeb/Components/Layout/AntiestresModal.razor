    protected override void OnInitialized()
    {
        Preferencias.OnCambio += OnPreferenciasChanged;
        if (Preferencias.AntiestresActivo)
            IniciarTimer();
    }

    private void OnPreferenciasChanged()
    {
        if (Preferencias.AntiestresActivo)
            IniciarTimer();
        else
            DetenerTimer();
    }

    private void IniciarTimer()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = BucleTimerAsync(_cts.Token);
    }

    private void DetenerTimer()
    {
        _cts?.Cancel();
        _cts = null;
    }

    private async Task BucleTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var espera = TimeSpan.FromSeconds(Preferencias.IntervaloAntiestresSeg);
            try { await Task.Delay(espera, ct); }
            catch (OperationCanceledException) { break; }
            if (!ct.IsCancellationRequested)
                await InvokeAsync(MostrarModal);
        }
    }

    private void MostrarModal()
    {
        var rng = new Random();
        int nuevo;
        do { nuevo = rng.Next(Mensajes.Length); } while (nuevo == _ultimoIndice && Mensajes.Length > 1);
        _ultimoIndice  = nuevo;
        _mensajeActual = Mensajes[nuevo];
        _visible       = true;
        StateHasChanged();
    }

    private void Cerrar()
    {
        _visible = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Preferencias.OnCambio -= OnPreferenciasChanged;
        _cts?.Cancel();
        await Task.CompletedTask;
    }
}
