@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@implements IAsyncDisposable

@if (_visible)
{
    <div class="ae-backdrop" @onclick="Cerrar">
        <div class="ae-card" @onclick:stopPropagation="true">

            <button class="ae-close" @onclick="Cerrar" aria-label="Cerrar">✕</button>

            <div class="ae-deco ae-deco--tl">🌟</div>
            <div class="ae-deco ae-deco--tr">✨</div>
            <div class="ae-deco ae-deco--bl">🎉</div>
            <div class="ae-deco ae-deco--br">💫</div>

            <div class="ae-dog-wrap">
                <img src="/images/dog.png" alt="Perro motivador" class="ae-dog" />
            </div>

            <div class="ae-bubble">
                <span class="ae-bubble__tail"></span>
                <p class="ae-msg">@_mensajeActual</p>
            </div>

            <button class="ae-btn" @onclick="Cerrar">
                ¡Gracias, lo necesitaba! 🐾
            </button>
        </div>
    </div>
}

